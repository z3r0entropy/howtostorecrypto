---
import { url } from "~/lib/url";
import "~/styles/global.css";

interface Props {
  /** Page title. Will be used as-is in <title>; keep under ~60 chars. */
  title: string;
  /** Meta description. Keep under ~155 chars for full SERP display. */
  description?: string;
  /** Override the canonical URL (defaults to current page absolute URL). */
  canonical?: string;
  /** Open Graph image path (site-relative or absolute). Defaults to /og.svg. */
  ogImage?: string;
  /** og:type. Defaults to "website"; use "article" for content pages. */
  ogType?: "website" | "article";
  /** ISO date for article:published_time, e.g. "2026-05-20". */
  publishedTime?: string;
  /** ISO date for article:modified_time. */
  modifiedTime?: string;
  /** Hide from search engines. Defaults to false. */
  noindex?: boolean;
  /** Comma-separated keyword list. Optional; Google ignores it but other engines may use it. */
  keywords?: string;
  hideNav?: boolean;
  hideFooter?: boolean;
}

const {
  title,
  description = "How to store crypto safely: a patient, vendor-neutral guide to self-custody, cold storage, seed phrase backup, multisig and inheritance — written so you do it once and do it right.",
  canonical,
  ogImage = "/og.svg",
  ogType = "website",
  publishedTime,
  modifiedTime,
  noindex = false,
  keywords,
  hideNav = false,
  hideFooter = false,
} = Astro.props;

const siteName = "How to Store Crypto";
const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://howtostorecrypto.com";

// Build a stable canonical URL. Strip trailing slash for non-root paths so
// duplicates ("/foo" vs "/foo/") don't compete in the index.
const rawPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const canonicalUrl = canonical ?? `${siteUrl}${rawPath}`;
const ogImageUrl = ogImage.startsWith("http") ? ogImage : `${siteUrl}${url(ogImage)}`;

const nav = [
  { label: "Plan", href: "/app/setup" },
  { label: "Locations", href: "/app/locations" },
  { label: "Quizzes", href: "/app/quiz" },
  { label: "Brand", href: "/brand" },
];

// Strip the base so `path` matches the author-written hrefs in `nav` (e.g. "/app/setup").
const basePrefix = import.meta.env.BASE_URL.replace(/\/$/, "");
const path =
  Astro.url.pathname
    .replace(/\/$/, "")
    .replace(new RegExp("^" + basePrefix.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")), "") || "/";
const isApp = path.startsWith("/app");

// Site-wide structured data. Pages can emit page-specific JSON-LD via the
// "head" slot — Google merges all JSON-LD blocks on the page.
const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: siteName,
  url: siteUrl,
  logo: `${siteUrl}${url("/og.svg")}`,
  description: "Patient, vendor-neutral guide to self-custody crypto storage.",
};

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteName,
  url: siteUrl,
  description,
  inLanguage: "en",
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <link rel="canonical" href={canonicalUrl} />

    {
      noindex ? (
        <meta name="robots" content="noindex,nofollow" />
      ) : (
        <meta
          name="robots"
          content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
        />
      )
    }

    <meta name="theme-color" content="#f4f8fc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c1a2e" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <!-- Open Graph -->
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="en_US" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Favicons (inline SVG keeps the request count down) -->
    <link
      rel="icon"
      href="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%231f3a68' stroke-width='1.6'><path d='M12 2 L20 6.5 L20 16.5 L12 21 L4 16.5 L4 6.5 Z'/><path d='M12 7 L16 11.5 L12 16 L8 11.5 Z'/></svg>"
    />
    <link rel="apple-touch-icon" href={url("/og.svg")} />

    <!-- Sitemap discoverability for crawlers that skip robots.txt -->
    <link rel="sitemap" type="application/xml" href={url("/sitemap-index.xml")} />

    <!-- Fonts are self-hosted: @fontsource-variable/inter is imported in
         global.css and bundled into _astro/ by Astro. No CDN, no external
         requests, works fully offline. -->

    <!-- Site-wide structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />

    <slot name="head" />
  </head>
  <body>
    <!-- Construction banner — site-wide, every page -->
    <div class="construction-banner" role="alert">
      <span class="construction-banner__icon" aria-hidden="true">⚠</span>
      <span>
        <strong>Under heavy construction.</strong>{" "}
        This site is a work-in-progress draft. Content, structure, and
        recommendations are not yet stable.
        <strong> Do not act on anything here without independent verification.</strong>
      </span>
    </div>

    {
      !hideNav && (
        <header class="fixed inset-x-0 z-50 mx-auto flex max-w-5xl items-center justify-between px-4" style="top: calc(env(safe-area-inset-top, 0px) + 56px);">
          <a
            href={url("/")}
            class="pill text-[var(--ink)] hover:text-[var(--ice-deep)]"
            aria-label="How to Store Crypto · home"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M12 2 L20 6.5 L20 16.5 L12 21 L4 16.5 L4 6.5 Z" />
              <path d="M12 7 L16 11.5 L12 16 L8 11.5 Z" />
            </svg>
            <span class="font-medium tracking-tight">How to Store Crypto</span>
          </a>

          <nav class="pill hidden gap-1 px-1.5! py-1! md:flex" aria-label="Primary">
            {
              nav.map((item) => {
                const isActive =
                  path === item.href ||
                  (item.href !== "/" && path.startsWith(item.href));
                return (
                  <a
                    href={url(item.href)}
                    aria-current={isActive ? "page" : undefined}
                    class:list={[
                      "rounded-full px-3 py-1.5 text-[11px] transition",
                      isActive
                        ? "bg-[var(--ink)] text-white"
                        : "text-[var(--ink-2)] hover:bg-white/70",
                    ]}
                  >
                    {item.label}
                  </a>
                );
              })
            }
          </nav>

          <a
            href={url(isApp ? "/" : "/app/setup")}
            class="btn btn-primary btn-sm"
          >
            {isApp ? "← Reading" : "Start →"}
          </a>
        </header>
      )
    }

    <slot />

    {
      !hideFooter && (
        <footer class="mx-auto max-w-6xl px-6 pb-12 pt-20 md:px-10">
          <div class="glass rounded-3xl p-8 md:p-12">
            <div class="grid grid-cols-12 gap-8">
              <div class="col-span-12 md:col-span-5">
                <a href={url("/")} class="flex items-center gap-2 text-[var(--ink)]">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <path d="M12 2 L20 6.5 L20 16.5 L12 21 L4 16.5 L4 6.5 Z" />
                    <path d="M12 7 L16 11.5 L12 16 L8 11.5 Z" />
                  </svg>
                  <span class="display text-lg">How to Store Crypto</span>
                </a>
                <p class="mt-4 max-w-xs text-sm text-[var(--ink-2)]">
                  A patient, opinionated, vendor-neutral guide to keeping your
                  seed phrase safe.
                </p>
              </div>

              <div class="col-span-6 md:col-span-3">
                <div class="text-xs uppercase tracking-[0.15em] text-[var(--dim)]">
                  Read
                </div>
                <ul class="mt-3 space-y-2 text-sm">
                  <li><a href={url("/#methods")} class="text-[var(--ink-2)] hover:text-[var(--ice-deep)]">Methods</a></li>
                  <li><a href={url("/#walkthrough")} class="text-[var(--ink-2)] hover:text-[var(--ice-deep)]">Walkthrough</a></li>
                  <li><a href={url("/#mistakes")} class="text-[var(--ink-2)] hover:text-[var(--ice-deep)]">Common mistakes</a></li>
                  <li><a href={url("/#faq")} class="text-[var(--ink-2)] hover:text-[var(--ice-deep)]">FAQ</a></li>
                </ul>
              </div>

              <div class="col-span-6 md:col-span-4">
                <div class="text-xs uppercase tracking-[0.15em] text-[var(--dim)]">
                  Use
                </div>
                <ul class="mt-3 space-y-2 text-sm">
                  <li><a href={url("/app/setup")} class="text-[var(--ink-2)] hover:text-[var(--ice-deep)]">Plan your setup</a></li>
                  <li><a href={url("/app/locations")} class="text-[var(--ink-2)] hover:text-[var(--ice-deep)]">Browse backup locations</a></li>
                  <li><a href={url("/app/quiz/knowledge")} class="text-[var(--ink-2)] hover:text-[var(--ice-deep)]">Knowledge quiz</a></li>
                  <li><a href={url("/app/quiz/audit")} class="text-[var(--ink-2)] hover:text-[var(--ice-deep)]">Audit your setup</a></li>
                  <li><a href={url("/brand")} class="text-[var(--ink-2)] hover:text-[var(--ice-deep)]">Brand &amp; design system</a></li>
                </ul>
              </div>
            </div>

            <div class="mt-10 flex flex-wrap items-center justify-between gap-4 border-t hairline pt-6 text-xs text-[var(--dim)]">
              <span>© 2026 How to Store Crypto</span>
              <span>Not financial advice. Not a custodian. Vendor-neutral.</span>
              <span>Built calmly. Updated regularly.</span>
            </div>
          </div>
        </footer>
      )
    }
  </body>
</html>
