        const fmt = (s: number): string =>
          s < 60 ? `${s} s`
          : s < 3600 ? `${Math.round(s / 60)} m`
          : s < 86400 ? `${(s / 3600).toFixed(1)} h`
          : s < 31536000 ? `${Math.round(s / 86400)} d`
          : `${(s / 31536000).toFixed(1)} y`;
        const update = () => {
          const n = parseInt(slider.value, 10);
          const sec = n === 0 ? 0 : Math.pow(2, n);
          nOut.textContent = String(n);
          tOut.textContent = fmt(sec);
          rows.forEach((r) => {
            const attempt = parseInt(r.dataset.attempt ?? "0", 10);
            r.classList.toggle("is-current", attempt === n);
            r.classList.toggle("is-dim", attempt > n && n > 0);
          });
        };
        slider.addEventListener("input", update);
        update();
      }
    }

    // ============================================================
    //  20 · Duress PIN — tap a PIN to reveal real/decoy wallet
    // ============================================================
    {
      const root = document.getElementById("duress");
      const label = document.getElementById("duress-label");
      const bal = document.getElementById("duress-balance");
      const addr = document.getElementById("duress-addr");
      if (root && label && bal && addr) {
        const states: Record<string, { label: string; bal: string; addr: string }> = {
          real:  { label: "real wallet · unlocked",  bal: "187.0419 BTC", addr: "bc1q9k8z3r4f7m2n…x4lz" },
          decoy: { label: "decoy wallet · unlocked", bal: "0.0521 BTC",   addr: "bc1qXa3kP7r2cQ8u…q8m" },
        };
        const apply = (kind: string | null) => {
          if (!kind) {
            root.removeAttribute("data-state");
            label.textContent = "enter PIN";
            bal.textContent = "— locked —";
            addr.textContent = " ";
            return;
          }
          const s = states[kind];
          root.dataset.state = kind;
          label.textContent = s.label;
          bal.textContent = s.bal;
          addr.textContent = s.addr;
        };
        root.querySelectorAll<HTMLButtonElement>(".duress__pin").forEach((b) => {
          b.addEventListener("click", () => {
            const cur = root.dataset.state ?? null;
            const next = b.dataset.pin ?? "";
            apply(cur === next ? null : next);
          });
        });
      }
    }

    // ============================================================
    //  22 · Hardware wallet anatomy — tap a part for its role
    // ============================================================
    {
      const root = document.getElementById("anatomy");
      const titleEl = document.getElementById("anatomy-title");
      const bodyEl = document.getElementById("anatomy-body");
      if (root && titleEl && bodyEl) {
        const data: Record<string, { title: string; body: string }> = {
          se: {
            title: "secure element",
            body: "A tamper-resistant chip that holds the seed and signs transactions internally. The seed never leaves it. Reading it out should be physically impractical even with the device in hand.",
          },
          mcu: {
            title: "MCU",
            body: "The general-purpose microcontroller. Runs the UI, handles USB, talks to the SE. Compromise of the MCU does not, by itself, expose the seed.",
          },
          screen: {
            title: "trusted screen",
            body: "The only screen that cannot be lied to by host malware. Always read receive addresses, amounts, and PIN status here — not on your computer.",
          },
          buttons: {
            title: "physical buttons",
            body: "Physical confirmation that a human approved the transaction. No software can press these. Required for every signature.",
          },
          usb: {
            title: "USB-C",
            body: "The only data path to the outside world. Data in, signed transactions out — the seed itself never flows through.",
          },
        };
        const parts = root.querySelectorAll<SVGGElement>(".anatomy__part");
        parts.forEach((p) => {
          p.addEventListener("click", () => {
            const id = p.dataset.part ?? "";
            const wasActive = p.classList.contains("is-active");
            parts.forEach((x) => x.classList.remove("is-active"));
            if (!wasActive) {
              p.classList.add("is-active");
              root.dataset.part = id;
              const d = data[id];
              if (d) {
                titleEl.textContent = d.title;
                bodyEl.textContent = d.body;
              }
            } else {
              root.removeAttribute("data-part");
              titleEl.textContent = "— tap a component —";
              bodyEl.textContent = "Each part has one job. Combined, they let you sign without ever revealing the seed.";
            }
          });
        });
      }
    }

    // ============================================================
    //  23 · Address verification — compromise host, see hw stays right
    // ============================================================
    {
      const root = document.getElementById("verify");
      const hostAddr = document.getElementById("verify-host-addr");
      const hwAddr = document.getElementById("verify-hw-addr");
      const statusEl = document.getElementById("verify-status");
      const compromiseBtn = document.getElementById("verify-compromise");
      const resetBtn = document.getElementById("verify-reset");
      if (root && hostAddr && hwAddr && statusEl && compromiseBtn && resetBtn) {
        const real = "bc1q9k8z3r4f7m2nlWpq6b3vYu5h0jE2t4kQx4lz";
        const fake = "bc1q9k8z3r4f7m2nXa3kP7r2cQ8u5h0jE2t4kQx4lz";
        const apply = (compromised: boolean) => {
          root.dataset.compromised = compromised ? "true" : "false";
          hostAddr.textContent = compromised ? fake : real;
          hwAddr.textContent = real;
          statusEl.textContent = compromised
            ? "addresses differ · DO NOT SEND — trust the device, not the host"
            : "addresses match · safe to send";
        };
        compromiseBtn.addEventListener("click", () => apply(true));
        resetBtn.addEventListener("click", () => apply(false));
        apply(false);
      }
    }

    // ============================================================
    //  24 · Tamper-evident seal — break / reseal
    // ============================================================
    {
      const root = document.getElementById("tamper");
      const breakBtn = document.getElementById("tamper-break");
      const resetBtn = document.getElementById("tamper-reset");
      const statusEl = document.getElementById("tamper-status");
      if (root && breakBtn && resetBtn && statusEl) {
        const apply = (broken: boolean) => {
          root.dataset.broken = broken ? "true" : "false";
          statusEl.textContent = broken
            ? "seal broken · return to sender, do not use"
            : "seal intact · device genuine";
        };
        breakBtn.addEventListener("click", () => apply(true));
        resetBtn.addEventListener("click", () => apply(false));
      }
    }

    // ============================================================
    //  25 · Dead man's switch — countdown with ping reset
    // ============================================================
    {
      const root = document.getElementById("dms");
      const ring = document.getElementById("dms-ring");
      const timeEl = document.getElementById("dms-time");
      const eventsEl = document.getElementById("dms-events");
      const pingBtn = document.getElementById("dms-ping");
      const resetBtn = document.getElementById("dms-reset");
      if (root && ring && timeEl && eventsEl && pingBtn && resetBtn) {
        const TOTAL_DAYS = 180;
        const CIRCUMFERENCE = 2 * Math.PI * 85;
        let days = TOTAL_DAYS;
        let timer: number | null = null;
        const setRing = () => {
          const frac = Math.max(0, days / TOTAL_DAYS);
          ring.setAttribute("stroke-dasharray", `${(frac * CIRCUMFERENCE).toFixed(1)} ${CIRCUMFERENCE.toFixed(1)}`);
          timeEl.textContent = String(Math.max(0, days));
          root.dataset.state = days > 60 ? "ok" : days > 30 ? "warn" : "critical";
        };
        const addEvent = (text: string, kind?: string) => {
          const el = document.createElement("div");
          el.className = `dms__event mono-readout${kind ? ` dms__event--${kind}` : ""}`;
          el.textContent = text;
          eventsEl.insertBefore(el, eventsEl.firstChild);
          while (eventsEl.children.length > 6) {
            eventsEl.removeChild(eventsEl.lastChild!);
          }
        };
        const tick = () => {
          days -= 1;
          setRing();
          if (days === 90) addEvent("day 90 · 90 days silent — warning sent", "alert");
          if (days === 30) addEvent("day 150 · 30 days remaining — heirs notified", "alert");
          if (days <= 0) {
            addEvent("day 180 · timer expired — inheritance triggered", "final");
            if (timer !== null) { clearInterval(timer); timer = null; }
          }
        };
        const start = () => {
          if (timer !== null) clearInterval(timer);
          timer = window.setInterval(tick, 90);
        };
        pingBtn.addEventListener("click", () => {
          const elapsed = TOTAL_DAYS - days;
          days = TOTAL_DAYS;
          setRing();
          addEvent(`day ${elapsed} · ping received — clock reset`);
          start();
        });
        resetBtn.addEventListener("click", () => {
          days = TOTAL_DAYS;
          setRing();
          eventsEl.innerHTML = "";
          addEvent("day 0 · system armed");
          start();
        });
        setRing();
        start();
      }
    }

    // ============================================================
    //  26 · Time-lock — slider sets duration, ring fills
    // ============================================================
    {
      const slider = document.getElementById("timelock-slider") as HTMLInputElement | null;
      const yearsOut = document.getElementById("timelock-years");
      const dateOut = document.getElementById("timelock-date");
      const remOut = document.getElementById("timelock-remaining");
      const ring = document.getElementById("timelock-progress");
      if (slider && yearsOut && dateOut && remOut && ring) {
        const NOW_YEAR = 2026;
        const CIRCUMFERENCE = 2 * Math.PI * 78;
        const MAX_YEARS = 20;
        const update = () => {
          const y = parseInt(slider.value, 10);
          yearsOut.textContent = String(y);
          dateOut.textContent = `${NOW_YEAR + y}-01-01`;
          remOut.textContent = y === 0 ? "unlocked" : `≈ ${y.toFixed(1)} y`;
          const frac = y / MAX_YEARS;
          ring.setAttribute("stroke-dasharray", `${(frac * CIRCUMFERENCE).toFixed(1)} ${CIRCUMFERENCE.toFixed(1)}`);
        };
        slider.addEventListener("input", update);
        update();
      }
    }

    // ============================================================
    //  27 · Address poisoning — toggle diff highlight
    // ============================================================
    {
      const root = document.getElementById("poison");
      const btn = document.getElementById("poison-toggle");
      if (root && btn) {
        btn.addEventListener("click", () => {
          const on = root.dataset.highlighted === "true";
          root.dataset.highlighted = on ? "false" : "true";
          (btn as HTMLButtonElement).textContent = on ? "Highlight diff" : "Hide diff";
        });
      }
    }

    // ============================================================
    //  29 · Air-gap PSBT — play through three steps
    // ============================================================
    {
      const root = document.getElementById("psbt");
      const playBtn = document.getElementById("psbt-play");
      if (root && playBtn) {
        const steps = Array.from(root.querySelectorAll<HTMLElement>(".psbt__step"));
        const arrows = Array.from(root.querySelectorAll<HTMLElement>(".psbt__arrow"));
        const reset = () => {
          steps.forEach((s) => s.classList.remove("is-active"));
          arrows.forEach((a) => a.classList.remove("is-active"));
        };
        playBtn.addEventListener("click", () => {
          reset();
          (playBtn as HTMLButtonElement).disabled = true;
          steps[0]?.classList.add("is-active");
          let i = 0;
          const advance = () => {
            if (i < arrows.length) {
              arrows[i].classList.add("is-active");
              window.setTimeout(() => {
                steps[i]?.classList.remove("is-active");
                steps[i + 1]?.classList.add("is-active");
                i++;
                window.setTimeout(advance, 600);
              }, 800);
            } else {
              (playBtn as HTMLButtonElement).disabled = false;
            }
          };
          window.setTimeout(advance, 400);
        });
      }
    }

    // ============================================================
    //  30 · Coin control — UTXO selection + linkage status
    // ============================================================
    {
      const root = document.getElementById("utxo");
      const countOut = document.getElementById("utxo-count");
      const totalOut = document.getElementById("utxo-total");
      const linkOut = document.getElementById("utxo-link");
      if (root && countOut && totalOut && linkOut) {
        const boxes = root.querySelectorAll<HTMLButtonElement>(".utxo__box");
        const update = () => {
          const selected = Array.from(boxes).filter((b) => b.getAttribute("aria-pressed") === "true");
          countOut.textContent = String(selected.length);
          const total = selected.reduce((acc, b) => acc + parseFloat(b.dataset.amt ?? "0"), 0);
          totalOut.textContent = total.toFixed(4);
          linkOut.textContent = selected.length <= 1
            ? "none"
            : selected.length === 2
            ? "weak · 2 utxos joined"
            : `strong · ${selected.length} histories merged`;
          (linkOut as HTMLElement).style.color =
            selected.length <= 1 ? "var(--ok)" : selected.length === 2 ? "var(--warn)" : "var(--coerce)";
        };
        boxes.forEach((b) => {
          b.addEventListener("click", () => {
            const next = b.getAttribute("aria-pressed") !== "true";
            b.setAttribute("aria-pressed", String(next));
            update();
          });
        });
        update();
      }
    }

    // ============================================================
    //  31 · Address reuse clustering — mode toggle
    // ============================================================
    {
      const root = document.getElementById("reuse");
      const status = document.getElementById("reuse-status");
      const freshBtn = document.getElementById("reuse-fresh");
      const reuseBtn = document.getElementById("reuse-reuse");
      if (root && status && freshBtn && reuseBtn) {
        const apply = (mode: "fresh" | "reuse") => {
          root.dataset.mode = mode;
          status.textContent = mode === "fresh"
            ? "5 payments · 5 unlinked receivers"
            : "5 payments · 1 cluster · sender identities merge";
        };
        freshBtn.addEventListener("click", () => apply("fresh"));
        reuseBtn.addEventListener("click", () => apply("reuse"));
      }
    }

    // ============================================================
    //  35 · RBF fee bump
    // ============================================================
    {
      const root = document.getElementById("rbf");
      const mine = document.getElementById("rbf-mine");
      const feeOut = document.getElementById("rbf-fee");
      const status = document.getElementById("rbf-status");
      const bumpBtn = document.getElementById("rbf-bump");
      const resetBtn = document.getElementById("rbf-reset");
      if (root && mine && feeOut && status && bumpBtn && resetBtn) {
        const apply = (bumped: boolean) => {
          root.dataset.bumped = String(bumped);
          const f = bumped ? 55 : 6;
          mine.style.height = `${f * 1.6}px`;
          feeOut.textContent = String(f);
          status.textContent = bumped
            ? "replaced · 55 sat/vB · included in next block"
            : "stuck · 6 sat/vB · ~4 hours to mine";
        };
        bumpBtn.addEventListener("click", () => apply(true));
        resetBtn.addEventListener("click", () => apply(false));
        apply(false);
      }
    }

    // ============================================================
    //  36 · Mempool fee market — slider sets cutoff
    // ============================================================
    {
      const root = document.getElementById("memp");
      const slider = document.getElementById("memp-slider") as HTMLInputElement | null;
      const rate = document.getElementById("memp-rate");
      const count = document.getElementById("memp-count");
      const threshold = document.getElementById("memp-threshold");
      if (root && slider && rate && count && threshold) {
        const bars = root.querySelectorAll<SVGRectElement>(".memp__bar");
        const update = () => {
          const r = parseInt(slider.value, 10);
          rate.textContent = String(r);
          // threshold line y = 140 - r * 1.3 (clamp to 0..140)
          const y = Math.max(0, Math.min(140, 140 - r * 1.3));
          threshold.setAttribute("y1", String(y));
          threshold.setAttribute("y2", String(y));
          let included = 0;
          bars.forEach((b) => {
            const f = parseInt(b.getAttribute("data-fee") ?? "0", 10);
            const ok = f >= r;
            b.classList.toggle("is-included", ok);
            b.classList.toggle("is-excluded", !ok);
            if (ok) included++;
          });
          count.textContent = String(included);
        };
        slider.addEventListener("input", update);
        update();
      }
    }

    // ============================================================
    //  37 · Proof of reserves Merkle — leaf click highlights path
    // ============================================================
    {
      const root = document.getElementById("por");
      const caption = document.getElementById("por-caption");
      if (root && caption) {
        const PATHS: Record<string, { nodes: string[]; edges: string[] }> = {
          a: { nodes: ["a", "ab", "root"], edges: ["a", "ab"] },
          b: { nodes: ["b", "ab", "root"], edges: ["b", "ab"] },
          c: { nodes: ["c", "cd", "root"], edges: ["c", "cd"] },
          d: { nodes: ["d", "cd", "root"], edges: ["d", "cd"] },
        };
        const leaves = root.querySelectorAll<SVGGElement>(".por__node--leaf");
        leaves.forEach((l) => {
          l.addEventListener("click", () => {
            const id = l.dataset.node ?? "";
            root.querySelectorAll(".is-active").forEach((el) => el.classList.remove("is-active"));
            const p = PATHS[id];
            if (!p) return;
            p.nodes.forEach((n) => root.querySelector(`.por__node[data-node="${n}"]`)?.classList.add("is-active"));
            p.edges.forEach((e) => root.querySelector(`line[data-pair="${e}"]`)?.classList.add("is-active"));
            caption.textContent = `leaf ${id} verified · ${p.edges.length} sibling hashes + ${p.nodes.length} computed → root match`;
          });
        });
      }
    }

    // ============================================================
    //  40 · Reproducible builds — toggle a compromised builder
    // ============================================================
    {
      const root = document.getElementById("repbuild");
      const status = document.getElementById("repbuild-status");
      const compBtn = document.getElementById("repbuild-compromise");
      const resetBtn = document.getElementById("repbuild-reset");
      if (root && status && compBtn && resetBtn) {
        const builder3 = root.querySelector<HTMLElement>('.repbuild__builder[data-builder="3"]');
        const apply = (compromised: boolean) => {
          root.dataset.compromised = String(compromised);
          if (compromised) {
            if (builder3) {
              const hash = builder3.querySelector<HTMLElement>(".repbuild__hash");
              const ok = builder3.querySelector<HTMLElement>(".repbuild__ok");
              if (hash) hash.textContent = "2a8e…c041";
              if (ok) ok.textContent = "✕";
            }
            status.textContent = "4 of 5 agree · ✕ release withheld — builder 3 differs";
          } else {
            if (builder3) {
              const hash = builder3.querySelector<HTMLElement>(".repbuild__hash");
              const ok = builder3.querySelector<HTMLElement>(".repbuild__ok");
              if (hash) hash.textContent = "9c4f…b817";
              if (ok) ok.textContent = "✓";
            }
            status.textContent = "5 of 5 agree · ✓ release verified";
          }
        };
        compBtn.addEventListener("click", () => apply(true));
        resetBtn.addEventListener("click", () => apply(false));
      }
    }

    // ============================================================
    //  43 · CoinJoin — slider sets participants, SVG redraws
    // ============================================================
    {
      const root = document.getElementById("coinjoin");
      const svg = document.getElementById("coinjoin-svg");
      const slider = document.getElementById("coinjoin-slider") as HTMLInputElement | null;
      const nOut = document.getElementById("coinjoin-n");
      const setOut = document.getElementById("coinjoin-set");
      if (root && svg && slider && nOut && setOut) {
        const NS = "http://www.w3.org/2000/svg";
        const draw = () => {
          // Clear all dynamic content (keep .coinjoin__mixer and label)
          Array.from(svg.querySelectorAll(".coinjoin__io-node, .coinjoin__io-line, .coinjoin__io-out")).forEach((el) => el.remove());
          const n = parseInt(slider.value, 10);
          nOut.textContent = String(n);
          setOut.textContent = String(n);
          for (let i = 0; i < n; i++) {
            const y = 20 + (i * (160 / Math.max(1, n - 1)));
            // input line + node
            const inLine = document.createElementNS(NS, "line");
            inLine.setAttribute("class", "coinjoin__io-line");
            inLine.setAttribute("x1", "30"); inLine.setAttribute("y1", String(y));
            inLine.setAttribute("x2", "130"); inLine.setAttribute("y2", "100");
            svg.appendChild(inLine);
            const inNode = document.createElementNS(NS, "circle");
            inNode.setAttribute("class", "coinjoin__io-node");
            inNode.setAttribute("cx", "30"); inNode.setAttribute("cy", String(y));
            inNode.setAttribute("r", "5");
            svg.appendChild(inNode);
            // output line + node
            const outLine = document.createElementNS(NS, "line");
            outLine.setAttribute("class", "coinjoin__io-line");
            outLine.setAttribute("x1", "190"); outLine.setAttribute("y1", "100");
            outLine.setAttribute("x2", "290"); outLine.setAttribute("y2", String(y));
            svg.appendChild(outLine);
            const outNode = document.createElementNS(NS, "circle");
            outNode.setAttribute("class", "coinjoin__io-out");
            outNode.setAttribute("cx", "290"); outNode.setAttribute("cy", String(y));
            outNode.setAttribute("r", "5");
            svg.appendChild(outNode);
          }
        };
        slider.addEventListener("input", draw);
        draw();
      }
    }

    // ============================================================
    //  44 · Privacy layers — toggle each, compute verdict
    // ============================================================
    {
      const root = document.getElementById("privlayer");
      const verdict = document.getElementById("privlayer-verdict");
      if (root && verdict) {
        const rows = root.querySelectorAll<HTMLButtonElement>(".privlayer__row");
        const update = () => {
          const on = new Set<string>();
          rows.forEach((r) => { if (r.dataset.on === "true") on.add(r.dataset.layer ?? ""); });
          let text: string; let priv: boolean;
          if (on.has("node")) { text = "your own node · nobody upstream sees your queries"; priv = true; }
          else if (on.has("tor")) { text = "Tor · circuit blinds origin · still trust exit node"; priv = true; }
          else if (on.has("vpn")) { text = "VPN · ISP blind · VPN provider sees everything"; priv = false; }
          else if (on.has("isp")) { text = "ISP knows you use a wallet"; priv = false; }
          else { text = "no privacy layer enabled"; priv = false; }
          verdict.textContent = text;
          verdict.classList.toggle("is-private", priv);
        };
        rows.forEach((r) => {
          r.addEventListener("click", () => {
            r.dataset.on = r.dataset.on === "true" ? "false" : "true";
            r.querySelector<HTMLElement>(".privlayer__toggle")!.textContent = r.dataset.on === "true" ? "ON" : "off";
            update();
          });
        });
        update();
      }
    }

    // ============================================================
    //  47 · Wallet attestation
    // ============================================================
    {
      const root = document.getElementById("attest");
      const status = document.getElementById("attest-status");
      const runBtn = document.getElementById("attest-run");
      const fakeBtn = document.getElementById("attest-fake");
      if (root && status && runBtn && fakeBtn) {
        runBtn.addEventListener("click", () => {
          root.dataset.state = "ok";
          status.textContent = "✓ signature verified · genuine device";
        });
        fakeBtn.addEventListener("click", () => {
          root.dataset.state = "fake";
          status.textContent = "✕ signature invalid · supply-chain clone detected";
        });
      }
    }

    // ============================================================
    //  48 · Spending velocity — slider sets daily cap
    // ============================================================
    {
      const slider = document.getElementById("velocity-slider") as HTMLInputElement | null;
      const capOut = document.getElementById("velocity-cap");
      const capOut2 = document.getElementById("velocity-cap-out");
      const usedOut = document.getElementById("velocity-used");
      const fill = document.getElementById("velocity-fill");
      if (slider && capOut && capOut2 && usedOut && fill) {
        const USED = 0.18;
        const update = () => {
          const cap = parseInt(slider.value, 10) / 100;
          capOut.textContent = cap.toFixed(2);
          capOut2.textContent = cap.toFixed(2);
          const pct = Math.min(100, (USED / Math.max(0.0001, cap)) * 100);
          fill.style.width = `${pct.toFixed(0)}%`;
        };
        slider.addEventListener("input", update);
        update();
      }
    }
  </script>
</Layout>
