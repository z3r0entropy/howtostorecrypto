    //  Geolocation pins — drag pins, sweep blast radius, count components
    // ============================================================
    {
      const root = document.getElementById("geoloc");
      const slider = document.getElementById("geoloc-slider") as HTMLInputElement | null;
      const rOut = document.getElementById("geoloc-r");
      const status = document.getElementById("geoloc-status");
      if (root && slider && rOut && status) {
        const svg = root.querySelector<SVGSVGElement>("svg.geoloc__map");
        if (svg) {
          const pins = Array.from(root.querySelectorAll<SVGGElement>(".geoloc__pin"));
          const rings = Array.from(root.querySelectorAll<SVGCircleElement>(".geoloc__ring"));
          // 1 SVG unit = 2.5 km on this map (400 SVG-units ≈ 1000 km)
          const kmToSvg = (km: number) => km / 2.5;

          const getPinPos = (g: SVGGElement) => {
            const m = /translate\(\s*([-\d.]+)\s*,\s*([-\d.]+)\s*\)/.exec(
              g.getAttribute("transform") ?? "translate(0,0)"
            );
            return m ? { x: parseFloat(m[1]), y: parseFloat(m[2]) } : { x: 0, y: 0 };
          };

          const setPinPos = (id: string, x: number, y: number) => {
            const pin = pins.find((p) => p.dataset.pin === id);
            const ring = rings.find((r) => r.getAttribute("data-pin") === id);
            if (pin) pin.setAttribute("transform", `translate(${x}, ${y})`);
            if (ring) {
              ring.setAttribute("cx", String(x));
              ring.setAttribute("cy", String(y));
            }
          };

          const clientToSvg = (e: PointerEvent) => {
            const rect = svg.getBoundingClientRect();
            return {
              x: ((e.clientX - rect.left) / rect.width) * 400,
              y: ((e.clientY - rect.top) / rect.height) * 260,
            };
          };

          const recompute = () => {
            const km = parseInt(slider.value, 10);
            rOut.textContent = String(km);
            const r = kmToSvg(km);
            rings.forEach((ring) => ring.setAttribute("r", String(r)));
            const positions = pins.map(getPinPos);
            const parent = positions.map((_, i) => i);
            const find = (i: number): number => (parent[i] === i ? i : (parent[i] = find(parent[i])));
            const union = (a: number, b: number) => { parent[find(a)] = find(b); };
            for (let i = 0; i < positions.length; i++) {
              for (let j = i + 1; j < positions.length; j++) {
                const d = Math.hypot(positions[i].x - positions[j].x, positions[i].y - positions[j].y);
                if (d < 2 * r) union(i, j);
              }
            }
            const groups = new Set(positions.map((_, i) => find(i)));
            const c = groups.size;
            root.dataset.components = String(c);
            status.textContent = c === 3
              ? "3 backups · 3 independent failure modes"
              : c === 2
              ? "3 backups · 2 independent failure modes · one pair shares risk"
              : "3 backups · 1 shared failure event — all could vanish together";
          };

          pins.forEach((pin) => {
            let dragId: number | null = null;
            let offsetX = 0, offsetY = 0;
            pin.addEventListener("pointerdown", (e: PointerEvent) => {
              e.preventDefault();
              pin.setPointerCapture(e.pointerId);
              dragId = e.pointerId;
              const pos = getPinPos(pin);
              const { x, y } = clientToSvg(e);
              offsetX = pos.x - x;
              offsetY = pos.y - y;
            });
            pin.addEventListener("pointermove", (e: PointerEvent) => {
              if (dragId !== e.pointerId) return;
              const { x, y } = clientToSvg(e);
              const nx = Math.max(20, Math.min(380, x + offsetX));
              const ny = Math.max(20, Math.min(240, y + offsetY));
              setPinPos(pin.dataset.pin ?? "", nx, ny);
              recompute();
            });
            const release = (e: PointerEvent) => {
              if (dragId === e.pointerId) {
                pin.releasePointerCapture(e.pointerId);
                dragId = null;
              }
            };
            pin.addEventListener("pointerup", release);
            pin.addEventListener("pointercancel", release);
          });

          slider.addEventListener("input", recompute);
          recompute();
        }
      }
    }

