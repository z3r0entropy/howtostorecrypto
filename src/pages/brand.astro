---
import { url } from "~/lib/url";
import Layout from "~/layouts/Layout.astro";
import worldLandPath from "~/lib/world-land-path.txt?raw";

const colors = [
  { name: "bg", hex: "#f4f8fc", use: "Page background (washed by atmospheric gradients)" },
  { name: "bg-2", hex: "#e6eef7", use: "Subtler surface tint" },
  { name: "surface", hex: "#ffffff", use: "Solid surfaces — used sparingly" },
  { name: "ink", hex: "#0c1a2e", use: "Primary text, primary button" },
  { name: "ink-2", hex: "#3b4a63", use: "Secondary text, body paragraphs" },
  { name: "dim", hex: "#6f7e94", use: "Captions, labels, eyebrows" },
  { name: "dimmer", hex: "#95a3b8", use: "Tertiary text, placeholder" },
  { name: "ice", hex: "#aac6e6", use: "Soft accent — sparingly" },
  { name: "ice-deep", hex: "#1f3a68", use: "Interactive hover state for primary" },
  { name: "accent", hex: "#2f6fe0", use: "Links, focus rings, recommended badges" },
  { name: "accent-deep", hex: "#1d4fb0", use: "Active link, accent-deep tags" },
  { name: "warn", hex: "#c45c3a", use: "Mistakes, warnings — never critical" },
  { name: "ok", hex: "#2f9468", use: "Confirmations, instead-do-this notes" },
];

const typeScale = [
  { name: "Display 7XL", className: "display text-7xl", sample: "Aa 24" },
  { name: "Display 5XL", className: "display text-5xl", sample: "Aa 24" },
  { name: "Display 3XL", className: "display text-3xl", sample: "Aa 24" },
  { name: "Display XL", className: "display text-xl", sample: "Aa 24" },
  { name: "Body LG", className: "text-lg", sample: "The quick brown fox" },
  { name: "Body MD", className: "text-base", sample: "The quick brown fox" },
  { name: "Body SM", className: "text-sm text-[var(--ink-2)]", sample: "The quick brown fox" },
  { name: "Eyebrow", className: "text-xs uppercase tracking-[0.2em] text-[var(--dim)]", sample: "Section eyebrow" },
  { name: "Mono", className: "text-sm", sample: "M1 STEEL · 0.875rem", mono: true },
];

const spacing = [
  ["2xs", "4px", "0.25rem"],
  ["xs", "8px", "0.5rem"],
  ["sm", "12px", "0.75rem"],
  ["md", "16px", "1rem"],
  ["lg", "24px", "1.5rem"],
  ["xl", "32px", "2rem"],
  ["2xl", "48px", "3rem"],
  ["3xl", "64px", "4rem"],
  ["4xl", "96px", "6rem"],
];

const radii = [
  ["xs", "6px", "Tag, kbd"],
  ["sm", "10px", "Small inputs"],
  ["md", "16px", "Inputs, small cards"],
  ["lg", "22px", "Standard chips"],
  ["xl", "28px", "Hero feature card"],
  ["2xl", "36px", "Large surface containers"],
];

const voice = [
  {
    do: "Patient and practical.",
    dont: "Urgent and panic-mongering.",
    why: "The audience already knows the stakes. They don't need to be sold on them.",
  },
  {
    do: "Vendor-neutral.",
    dont: "Comparing brands by name in the main copy.",
    why: "The brand market shifts faster than guides should. Vendor specifics live in dated deep-dives.",
  },
  {
    do: "Acknowledge trade-offs.",
    dont: "Pretending one method is right for everyone.",
    why: "Different people, different holdings, different lives. Honest trade-offs earn trust.",
  },
  {
    do: "Plain language.",
    dont: "Cypherpunk jargon as filler.",
    why: "Terminology is used when it carries weight. Otherwise, English.",
  },
  {
    do: "Lowercase headlines feel calmer; sentence-case is the default. Title-case is reserved for the brand mark.",
    dont: "All-caps shouting outside of small labels and tags.",
    why: "The design language is quiet. The copy should match.",
  },
];
---

<Layout
  title="Brand & design system — How to Store Crypto"
  description="The design language behind the site: logo, color, typography, components, patterns, and voice."
  noindex={true}
>
  <main class="mx-auto max-w-6xl px-6 pt-32 pb-20 md:px-10">
    <!-- ============================================================
         Page header
         ============================================================ -->
    <header class="mb-20">
      <div class="pill"><span class="pill-dot"></span> Design system · v0.1 · 20 May 2026</div>
      <h1 class="display mt-6 text-[clamp(2.5rem,6vw,5.5rem)] leading-[0.95]">
        Brand &amp;
        <span class="stat-grad italic">design system.</span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-[var(--ink-2)]">
        The visual language behind <a href={url("/")} class="text-[var(--accent)] hover:text-[var(--accent-deep)]">How&nbsp;to&nbsp;Store&nbsp;Crypto</a>.
        Tokens, components, patterns, and the editorial tone that ties them
        together. Mostly intended as a reference for me as I add the rest of
        the site.
      </p>
    </header>

    <!-- Table of contents -->
    <nav class="glass mb-20 rounded-2xl p-2">
      <ul class="flex flex-wrap gap-1 text-xs">
        {
          [
            ["Visualizations", "#visuals"],
            ["Logo", "#logo"],
            ["Color", "#color"],
            ["Typography", "#type"],
            ["Spacing", "#spacing"],
            ["Radii & elevation", "#radii"],
            ["Buttons", "#buttons"],
            ["Pills & tags", "#tags"],
            ["Cards & surfaces", "#cards"],
            ["Forms", "#forms"],
            ["Tables", "#tables"],
            ["Patterns", "#patterns"],
            ["Voice & tone", "#voice"],
          ].map(([l, h]) => (
            <li>
              <a
                href={h}
                class="rounded-full px-3 py-1.5 text-[var(--ink-2)] transition hover:bg-white/70"
              >
                {l}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- ============================================================
         Visualizations — design / plan / store visual elements
         ============================================================ -->
    <section id="visuals" class="mb-24">
      <header class="mb-10">
        <div class="text-xs uppercase tracking-[0.2em] text-[var(--dim)]">00 · Visualizations</div>
        <h2 class="display mt-2 text-4xl">Hero artwork &amp; diagrams</h2>
        <p class="mt-3 max-w-2xl text-[var(--ink-2)]">
          The interactive, animated set pieces. Each one is meant to make a
          single idea legible without prose — the seed phrase is a number,
          entropy is unfathomable, multisig fails gracefully, cold beats hot.
        </p>
      </header>

      <!-- ---------------------------------------------------------------
           1 · Seed phrase orb (lifted from the landing hero)
           --------------------------------------------------------------- -->
      <div class="glass mb-6 rounded-2xl p-8 md:p-12">
        <div class="grid grid-cols-12 items-center gap-10">
          <div class="col-span-12 md:col-span-5">
            <div class="text-[11px] uppercase tracking-[0.15em] text-[var(--dim)]">01 · Seed phrase orb</div>
            <h3 class="display mt-3 text-3xl">The 24-word vault.</h3>
            <p class="mt-3 text-sm text-[var(--ink-2)]">
              The centerpiece of the landing hero. A frosted ring with the
              seed-phrase count, two floating tiles for survivability and
              brute-force facts. Slow vertical float on each element keeps the
              composition alive without demanding attention.
            </p>
            <div class="mt-5 flex flex-wrap gap-2">
              <span class="tag tag-neutral">.frost · .glass · .float</span>
              <span class="tag tag-accent">Hero — index.astro</span>
            </div>
          </div>
          <div class="col-span-12 md:col-span-7">
            <div class="relative mx-auto aspect-square w-full max-w-md">
              <div class="absolute inset-0 rounded-full frost ring-soft float"></div>
              <div class="glass absolute inset-[10%] flex flex-col items-center justify-center rounded-[28px] text-center">
                <div class="text-[10px] uppercase tracking-[0.2em] text-[var(--dim)]">
                  your seed phrase
                </div>
                <div class="display mt-3 stat-grad text-7xl">24</div>
                <div class="mt-2 text-sm text-[var(--ink-2)]">words · BIP-39</div>
                <div class="mt-8 flex gap-1.5">
                  {Array.from({ length: 24 }).map((_, i) => (
                    <span
                      class="size-1.5 rounded-full"
                      style={`background: rgba(31,58,104,${0.15 + (i % 5) * 0.15})`}
                    />
                  ))}
                </div>
                <div class="pill mt-8 text-[var(--ice-deep)]!">
                  ❄ offline · isolated · permanent
                </div>
              </div>

              <div class="glass absolute -left-6 top-1/3 rounded-2xl px-4 py-3 text-xs float" style="animation-delay: -2s;">
                <div class="text-[10px] uppercase tracking-[0.15em] text-[var(--dim)]">Survives</div>
                <div class="mt-1 text-[var(--ink)]">🔥 1400°C · 💧 indefinitely</div>
              </div>
              <div class="glass absolute -right-4 bottom-1/4 rounded-2xl px-4 py-3 text-xs float" style="animation-delay: -4s;">
                <div class="text-[10px] uppercase tracking-[0.15em] text-[var(--dim)]">Brute force</div>
                <div class="mt-1 text-[var(--ink)]">≈ 10⁶⁰ years</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ---------------------------------------------------------------
           2 · Entropy lattice + 3 · Multisig constellation (two-up)
           --------------------------------------------------------------- -->
      <div class="mb-6 grid grid-cols-1 gap-6 md:grid-cols-2">
        <!-- Entropy lattice -->
        <div class="glass rounded-2xl p-8">
          <div class="text-[11px] uppercase tracking-[0.15em] text-[var(--dim)]">02 · Entropy lattice</div>
          <h3 class="display mt-3 text-2xl">256 bits, drifting.</h3>
          <p class="mt-3 text-sm text-[var(--ink-2)]">
            A 16×16 grid — one cell per bit of a BIP-39 seed. Cells shimmer on
            independent delays, hinting at the vastness of the keyspace.
            <strong>Tap any cell</strong> to lock it bright.
          </p>

          <div class="entropy-lattice mt-6 grid grid-cols-16 gap-1.5" id="entropy-lattice" aria-label="256-bit entropy visualization">
            {Array.from({ length: 256 }).map((_, i) => (
              <button
                type="button"
                class="entropy-cell"
                aria-label={`bit ${i + 1}`}
                style={`animation-delay: ${(i * 73) % 4000}ms; animation-duration: ${3500 + ((i * 113) % 2500)}ms;`}
              ></button>
            ))}
          </div>
          <div class="entropy-counter" aria-live="polite">
            <span>locked · <strong id="entropy-locked">0</strong>/256</span>
            <span id="entropy-search">remaining · 2²⁵⁶</span>
          </div>

          <div class="mt-6 grid grid-cols-3 gap-3 text-center">
            <div>
              <div class="display stat-grad text-2xl">2²⁵⁶</div>
              <div class="mt-1 text-[10px] uppercase tracking-[0.15em] text-[var(--dim)]">possible seeds</div>
            </div>
            <div>
              <div class="display stat-grad text-2xl">10⁷⁷</div>
              <div class="mt-1 text-[10px] uppercase tracking-[0.15em] text-[var(--dim)]">≈ atoms in universe</div>
            </div>
            <div>
              <div class="display stat-grad text-2xl">10⁶⁰ y</div>
              <div class="mt-1 text-[10px] uppercase tracking-[0.15em] text-[var(--dim)]">to brute force</div>
            </div>
          </div>
        </div>

        <!-- Multisig constellation -->
        <div class="glass rounded-2xl p-8">
          <div class="text-[11px] uppercase tracking-[0.15em] text-[var(--dim)]">03 · Multisig constellation</div>
          <h3 class="display mt-3 text-2xl">2-of-3, gracefully.</h3>
          <p class="mt-3 text-sm text-[var(--ink-2)]">
            Three keys, one vault, a threshold of two. <strong>Tap a key</strong>
            to lose it. One loss is survivable; two is not. The status line
            updates with the threshold math.
          </p>

          <div class="multisig mt-6 relative mx-auto aspect-square w-full max-w-[320px]" id="multisig" data-lost="0">
            <svg class="absolute inset-0 size-full" viewBox="0 0 200 200" fill="none" aria-hidden="true">
              <line x1="100" y1="40" x2="40" y2="150"  class="multisig-edge" data-endpoints="1-2" stroke-width="1.2" />
              <line x1="100" y1="40" x2="160" y2="150" class="multisig-edge" data-endpoints="1-3" stroke-width="1.2" />
              <line x1="40" y1="150" x2="160" y2="150" class="multisig-edge" data-endpoints="2-3" stroke-width="1.2" />
              <line x1="100" y1="40"  x2="100" y2="110" class="multisig-edge-vault" data-key="1" stroke-width="1.2" />
              <line x1="40" y1="150"  x2="100" y2="110" class="multisig-edge-vault" data-key="2" stroke-width="1.2" />
              <line x1="160" y1="150" x2="100" y2="110" class="multisig-edge-vault" data-key="3" stroke-width="1.2" />
              <g class="multisig-vault">
                <path d="M100 95 L110 102.5 L110 117.5 L100 125 L90 117.5 L90 102.5 Z" stroke-width="1.4" stroke-linejoin="round" />
                <path d="M100 101 L105 106 L100 111 L95 106 Z" stroke-width="1.4" stroke-linejoin="round" />
              </g>
            </svg>

            <button type="button" class="multisig-key" data-key="1" style="top: 14%; left: 50%; transform: translate(-50%, -50%);" aria-label="Key 1">
              <span class="multisig-key__hex">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 2 L20 6.5 L20 16.5 L12 21 L4 16.5 L4 6.5 Z" />
                  <path d="M12 7 L16 11.5 L12 16 L8 11.5 Z" />
                </svg>
              </span>
              <span class="multisig-key__label">Key 1</span>
            </button>
            <button type="button" class="multisig-key" data-key="2" style="top: 78%; left: 18%; transform: translate(-50%, -50%);" aria-label="Key 2">
              <span class="multisig-key__hex">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 2 L20 6.5 L20 16.5 L12 21 L4 16.5 L4 6.5 Z" />
                  <path d="M12 7 L16 11.5 L12 16 L8 11.5 Z" />
                </svg>
              </span>
              <span class="multisig-key__label">Key 2</span>
            </button>
            <button type="button" class="multisig-key" data-key="3" style="top: 78%; left: 82%; transform: translate(-50%, -50%);" aria-label="Key 3">
              <span class="multisig-key__hex">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 2 L20 6.5 L20 16.5 L12 21 L4 16.5 L4 6.5 Z" />
                  <path d="M12 7 L16 11.5 L12 16 L8 11.5 Z" />
                </svg>
              </span>
              <span class="multisig-key__label">Key 3</span>
            </button>
          </div>

          <div class="mt-6 flex items-center justify-between gap-3">
            <div>
              <div class="display text-lg" id="multisig-status">3 of 3 · funds safe</div>
              <div class="mt-1 text-xs text-[var(--dim)]" id="multisig-detail">All keys present. Threshold is 2.</div>
            </div>
            <button type="button" class="btn btn-ghost btn-sm" id="multisig-reset">Restore all</button>
          </div>
        </div>
      </div>

      <!-- ---------------------------------------------------------------
           4 · Threat survivability + 5 · Cold-to-hot spectrum (two-up)
           --------------------------------------------------------------- -->
      <div class="mb-6 grid grid-cols-1 gap-6 md:grid-cols-2">
        <!-- Threat survivability ring -->
        <div class="glass rounded-2xl p-8">
          <div class="text-[11px] uppercase tracking-[0.15em] text-[var(--dim)]">04 · Threat ring</div>
          <h3 class="display mt-3 text-2xl">Four threats, orbiting.</h3>
          <p class="mt-3 text-sm text-[var(--ink-2)]">
            A stamped-steel seed plate at center, with the four threats this
            site cares about drifting around it. Each carries its survival
            verdict; the orbit is slow and ambient.
          </p>

          <div class="threat-ring mt-6 mx-auto aspect-square w-full max-w-[340px]">
            <div class="threat-ring__orbit">
              <div class="threat-ring__icon" style="--orbit-angle: 0deg;">
                <div class="threat-ring__counter">
                  <svg class="threat-ring__icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true">
                    <path d="M12 3 C 10 6.5 7 8 7 12.5 C 7 15.8 9.2 18 12 18 C 14.8 18 17 15.8 17 12.5 C 17 10 14.5 8.5 13 6 Z" />
                    <path d="M12 11 C 11 12.5 10.5 13.5 10.5 14.7 C 10.5 15.7 11.1 16.3 12 16.3 C 12.9 16.3 13.5 15.7 13.5 14.8 C 13.5 13.8 12.8 13 12 11 Z" />
                  </svg>
                  <div class="threat-ring__verdict">1400°C · fire</div>
                </div>
              </div>
              <div class="threat-ring__icon" style="--orbit-angle: 90deg;">
                <div class="threat-ring__counter">
                  <svg class="threat-ring__icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true">
                    <path d="M12 3 C 8 8 6 11 6 14 A 6 6 0 0 0 18 14 C 18 11 16 8 12 3 Z" />
                    <path d="M9 14 C 9 15.5 10 16.5 11.5 16.5" />
                  </svg>
                  <div class="threat-ring__verdict">∞ · water</div>
                </div>
              </div>
              <div class="threat-ring__icon" style="--orbit-angle: 180deg;">
                <div class="threat-ring__counter">
                  <svg class="threat-ring__icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true">
                    <path d="M4 14 L10 8 L13 11 L7 17 Z" />
                    <path d="M10 8 L17 5 L20 8 L13 11" />
                    <path d="M6 15 L9 18" />
                  </svg>
                  <div class="threat-ring__verdict">won't dent</div>
                </div>
              </div>
              <div class="threat-ring__icon" style="--orbit-angle: 270deg;">
                <div class="threat-ring__counter">
                  <svg class="threat-ring__icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true">
                    <path d="M7 3 L17 3 M7 21 L17 21" />
                    <path d="M7 3 L7 6 L12 11 L7 16 L7 21" />
                    <path d="M17 3 L17 6 L12 11 L17 16 L17 21" />
                    <path d="M9 18 L15 18" />
                  </svg>
                  <div class="threat-ring__verdict">centuries</div>
                </div>
              </div>
            </div>
            <div class="threat-ring__core">
              <div class="threat-ring__plate">
                <div class="text-[9px] uppercase tracking-[0.2em] text-[var(--dim)]">316 stainless</div>
                <div class="display mt-1 stat-grad text-3xl">M1</div>
                <div class="mt-1 text-[10px] uppercase tracking-[0.15em] text-[var(--dim)]">stamped plate</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Cold-to-hot spectrum -->
        <div class="glass rounded-2xl p-8">
          <div class="text-[11px] uppercase tracking-[0.15em] text-[var(--dim)]">05 · Custody spectrum</div>
          <h3 class="display mt-3 text-2xl">Cold ↔ hot, animated.</h3>
          <p class="mt-3 text-sm text-[var(--ink-2)]">
            The custody continuum, from a steel plate buried in the garden to
            an exchange's hot wallet. A drifting marker pings each station in
            turn, the way attention drifts when you're deciding where to keep
            things.
          </p>

          <div class="spectrum mt-8" id="custody-spectrum">
            <div class="spectrum__track">
              <div class="spectrum__marker" aria-hidden="true"></div>
              <button type="button" class="spectrum__tick" style="left: 0%;"   data-station="steel"    aria-label="Steel"></button>
              <button type="button" class="spectrum__tick" style="left: 25%;"  data-station="multisig" aria-label="Multisig"></button>
              <button type="button" class="spectrum__tick" style="left: 50%;"  data-station="hardware" aria-label="Hardware"></button>
              <button type="button" class="spectrum__tick" style="left: 75%;"  data-station="mobile"   aria-label="Mobile"></button>
              <button type="button" class="spectrum__tick" style="left: 100%;" data-station="exchange" aria-label="Exchange"></button>
            </div>
            <div class="spectrum__labels">
              <div class="spectrum__label">
                <div class="display text-[11px] uppercase tracking-[0.15em]">steel</div>
                <div class="text-[10px] text-[var(--dim)]">airgap</div>
              </div>
              <div class="spectrum__label">
                <div class="display text-[11px] uppercase tracking-[0.15em]">multisig</div>
                <div class="text-[10px] text-[var(--dim)]">cold</div>
              </div>
              <div class="spectrum__label">
                <div class="display text-[11px] uppercase tracking-[0.15em]">hardware</div>
                <div class="text-[10px] text-[var(--dim)]">cool</div>
              </div>
              <div class="spectrum__label">
                <div class="display text-[11px] uppercase tracking-[0.15em]">mobile</div>
                <div class="text-[10px] text-[var(--dim)]">warm</div>
              </div>
              <div class="spectrum__label">
                <div class="display text-[11px] uppercase tracking-[0.15em]">exchange</div>
                <div class="text-[10px] text-[var(--warn)]">hot</div>
              </div>
            </div>

            <div class="spectrum__detail" aria-live="polite">
              <div class="spectrum__detail-title" id="spectrum-title">— tap a station —</div>
              <div class="mono-readout text-[11px] text-[var(--dim)]" id="spectrum-attack">attack surface · —</div>
              <div class="mono-readout text-[11px] text-[var(--dim)]" id="spectrum-time">spend latency · —</div>
              <p class="spectrum__detail-body" id="spectrum-body">
                Every station along the spectrum is a trade-off between how
                fast you can move funds and how many ways the funds can be
                taken from you. Tap a tick to expand.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- ---------------------------------------------------------------
           7 · Half-life chart + 8 · Atrophy gauge (two-up)
           --------------------------------------------------------------- -->
      <div class="mb-6 grid grid-cols-1 gap-6 md:grid-cols-2">
        <!-- Half-life chart -->
        <div class="glass rounded-2xl p-8">
          <div class="text-[11px] uppercase tracking-[0.15em] text-[var(--dim)]">07 · Half-life chart</div>
          <h3 class="display mt-3 text-2xl">Drag the years.</h3>
          <p class="mt-3 text-sm text-[var(--ink-2)]">
            Six common storage media against the years they're expected to
            survive. <strong>Drag the cursor</strong> — watch each medium
            silently fail. Steel wins the long game; cloud accounts almost
            never reach a decade.
          </p>

          <div class="halflife mt-8" id="halflife">
            <div class="halflife__axis">
              <div class="halflife__cursor" id="halflife-cursor" data-year="0" style="left: 0%;"></div>
              <div class="halflife__grat" style="left: 0%;"><span class="halflife__grat-label">year 0</span></div>
              <div class="halflife__grat" style="left: 16.7%;"><span class="halflife__grat-label">50</span></div>
              <div class="halflife__grat" style="left: 33.3%;"><span class="halflife__grat-label">100</span></div>
              <div class="halflife__grat" style="left: 50%;"><span class="halflife__grat-label">150</span></div>
              <div class="halflife__grat" style="left: 66.7%;"><span class="halflife__grat-label">200</span></div>
              <div class="halflife__grat" style="left: 83.3%;"><span class="halflife__grat-label">250</span></div>
              <div class="halflife__grat" style="left: 100%;"><span class="halflife__grat-label">300</span></div>
            </div>

            <div class="halflife__rows">
              {[
                { name: "316 stainless", note: "stamped plate",  life: 300 },
                { name: "Brass plate",   note: "engraved",       life: 250 },
                { name: "Acid-free paper", note: "boxed, dry",   life: 75  },
                { name: "Hardware wallet", note: "firmware/battery", life: 8 },
                { name: "SD card",       note: "consumer flash", life: 7   },
                { name: "Cloud account", note: "corporate",      life: 15  },
              ].map((m) => (
                <div class="halflife__row" data-life={m.life} data-failed="false">
                  <div class="halflife__name">{m.name}<small>{m.note}</small></div>
                  <div class="halflife__bar">
                    <div class="halflife__bar-fill" style={`width: ${(m.life / 300) * 100}%;`}></div>
                  </div>
                  <div class="halflife__verdict">survives</div>
                </div>
              ))}
            </div>

            <div class="mt-8">
              <div class="flex justify-between text-[10px] uppercase tracking-[0.15em] text-[var(--dim)] font-mono mb-1">
                <span>year</span>
                <span class="mono-readout text-[var(--ink)] text-[12px]"><span id="halflife-year">0</span> / 300</span>
              </div>
              <input
                type="range"
                id="halflife-slider"
                class="cold-slider"
                min="0"
                max="300"
                value="0"
                step="1"
                aria-label="Year cursor"
              />
            </div>
          </div>
        </div>

        <!-- Atrophy gauge -->
        <div class="glass rounded-2xl p-8">
          <div class="text-[11px] uppercase tracking-[0.15em] text-[var(--dim)]">08 · Atrophy gauge</div>
          <h3 class="display mt-3 text-2xl">The forgetting curve.</h3>
          <p class="mt-3 text-sm text-[var(--ink-2)]">
            The most underrated failure mode: <em>you</em>, in twenty years,
            wondering where you put the thing. <strong>Drag the slider</strong>
            — annual rehearsals are the single biggest lever you have.
          </p>

          <div class="atrophy mt-8" id="atrophy">
            <div class="atrophy__gauge">
              <svg viewBox="0 0 280 165" class="w-full h-auto" aria-hidden="true">
                <defs>
                  <linearGradient id="atrophy-grad" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="#2f9468" />
                    <stop offset="55%" stop-color="#2f6fe0" />
                    <stop offset="100%" stop-color="#c45c3a" />
                  </linearGradient>
                </defs>
                <path class="atrophy__arc-track" d="M 30 130 A 110 110 0 0 1 250 130" />
                <path class="atrophy__arc-fill" id="atrophy-arc" d="M 30 130 A 110 110 0 0 1 250 130"
                      stroke-dasharray="0 999" />
                <!-- tick marks at 0/25/50/75/100 % -->
                {[0, 25, 50, 75, 100].map((p) => {
                  const angle = Math.PI * (1 - p / 100);
                  const x1 = 140 + Math.cos(angle) * 96;
                  const y1 = 130 - Math.sin(angle) * 96;
                  const x2 = 140 + Math.cos(angle) * 84;
                  const y2 = 130 - Math.sin(angle) * 84;
                  return (
                    <line x1={x1} y1={y1} x2={x2} y2={y2} stroke="var(--dim)" stroke-width="1" />
                  );
                })}
                <text x="22"  y="148" fill="var(--dim)" font-family="var(--font-mono)" font-size="9" letter-spacing="0.1em">0%</text>
                <text x="245" y="148" fill="var(--dim)" font-family="var(--font-mono)" font-size="9" letter-spacing="0.1em">100%</text>
                <g class="atrophy__needle" id="atrophy-needle">
                  <line x1="140" y1="130" x2="140" y2="40" />
                  <circle cx="140" cy="130" r="6" />
                </g>
              </svg>
              <div class="atrophy__readout">
                <div class="atrophy__pct stat-grad" id="atrophy-pct">35.5%</div>
                <div class="atrophy__pct-label">forget over 20y</div>
              </div>
            </div>

            <div class="atrophy__control">
              <div class="atrophy__control-row">
                <span>rehearsals / year</span>
                <strong class="mono-readout"><span id="atrophy-val">0</span></strong>
              </div>
              <input
                type="range"
                id="atrophy-slider"
                class="cold-slider"
                min="0"
                max="12"
                value="0"
                step="1"
                aria-label="Rehearsals per year"
              />
            </div>
          </div>
        </div>
      </div>

      <!-- ---------------------------------------------------------------
           9 · Inheritance clock + 10 · Coercion ladder (two-up)
           --------------------------------------------------------------- -->
      <div class="mb-6 grid grid-cols-1 gap-6 md:grid-cols-2">
        <!-- Inheritance routing -->
        <div class="glass rounded-2xl p-8">
          <div class="text-[11px] uppercase tracking-[0.15em] text-[var(--dim)]">09 · Inheritance routing</div>
          <h3 class="display mt-3 text-2xl">Three secrets, three heirs.</h3>
          <p class="mt-3 text-sm text-[var(--ink-2)]">
            Recovery needs three things: the <em>location</em>, the
            <em>phrase</em>, the <em>passphrase</em>. Each routes to one heir.
            <strong>Tap a secret</strong> to send it elsewhere. All-to-one is
            a single point of failure; any-to-no-one is no recovery.
          </p>

          <div class="heir-flow mt-8" id="heir-flow" data-state="warn">
            <div class="heir-flow__secrets">
              {[
                { id: "location", name: "location",   sub: "where it's stored", color: "ice" },
                { id: "phrase",   name: "phrase",     sub: "the 24 words",      color: "accent" },
                { id: "pass",     name: "passphrase", sub: "the 25th word",     color: "ink" },
              ].map((s) => (
                <button type="button" class="heir-flow__secret" data-secret={s.id} data-heir="0" data-color={s.color}>
                  <span class="heir-flow__secret-stripe" aria-hidden="true"></span>
                  <span class="heir-flow__secret-name mono-readout">{s.name}</span>
                  <span class="heir-flow__secret-sub">{s.sub}</span>
                </button>
              ))}
            </div>

            <svg viewBox="0 0 600 80" class="heir-flow__svg" id="heir-flow-svg" aria-hidden="true" preserveAspectRatio="none">
              <line class="heir-flow__line heir-flow__line--ice"    data-secret="location" x1="100" y1="0" x2="75" y2="80" />
              <line class="heir-flow__line heir-flow__line--accent" data-secret="phrase"   x1="300" y1="0" x2="75" y2="80" />
              <line class="heir-flow__line heir-flow__line--ink"    data-secret="pass"     x1="500" y1="0" x2="75" y2="80" />
            </svg>

            <div class="heir-flow__heirs">
              {[
                { id: "0", name: "no one"   },
                { id: "1", name: "spouse"   },
                { id: "2", name: "executor" },
                { id: "3", name: "lawyer"   },
              ].map((h) => (
                <div class="heir-flow__heir" data-heir-id={h.id} data-count="0">
                  <div class="heir-flow__heir-name mono-readout">{h.name}</div>
                  <div class="heir-flow__heir-stripes" data-heir-stripes={h.id}></div>
                </div>
              ))}
            </div>

            <div class="heir-flow__verdict" id="heir-flow-verdict" aria-live="polite">no recovery · 3 of 3 secrets go nowhere</div>
          </div>
        </div>

        <!-- Coercion ladder -->
        <div class="glass rounded-2xl p-8">
          <div class="text-[11px] uppercase tracking-[0.15em] text-[var(--dim)]">10 · Coercion ladder</div>
          <h3 class="display mt-3 text-2xl">From couch cushion to wrench.</h3>
          <p class="mt-3 text-sm text-[var(--ink-2)]">
            Five threat tiers, ascending. The defense changes at each rung —
            and the top rung is the one most people forget exists.
            <strong>Tap a tier</strong> to expand.
          </p>

          <div class="coerce-ladder mt-6">
            <div class="coerce-ladder__rail" aria-hidden="true"></div>
            {[
              {
                tier: 1,
                name: "Lost in the couch",
                body: "You can't find the device or the backup. Mundane. The most common loss event. There's no attacker.",
                defense: "two locations · written record",
              },
              {
                tier: 2,
                name: "Phishing / fake support",
                body: "A site, email, or pop-up convinces you to enter your seed phrase. By far the most common successful theft.",
                defense: "never type the seed into anything",
              },
              {
                tier: 3,
                name: "Social engineering",
                body: "Someone in your life — or pretending to be — extracts information through conversation. Includes SIM-swap pretexting.",
                defense: "don't disclose holdings · separate identities",
              },
              {
                tier: 4,
                name: "Burglary, you absent",
                body: "Physical search of the home. They take the steel plate, the device, anything obvious. They leave without you.",
                defense: "geographically split shares · multisig",
              },
              {
                tier: 5,
                name: "Coerced presence ($5 wrench)",
                body: "You are present, and pressed, and not bluffing the attacker. The only defense at this tier is that the funds appear to be the funds.",
                defense: "plausible deniability · decoy wallet",
              },
            ].map((t) => (
              <details class="coerce-tier" data-tier={t.tier}>
                <summary>
                  <span class="coerce-tier__dot" aria-hidden="true"></span>
                  <span class="coerce-tier__num">T{t.tier}</span>
                  <span class="coerce-tier__name">{t.name}</span>
                  <span class="coerce-tier__chev" aria-hidden="true">›</span>
                </summary>
                <div class="coerce-tier__body">
                  {t.body}
                  <div class="coerce-tier__defense">↳ {t.defense}</div>
                </div>
              </details>
            ))}
          </div>
        </div>
      </div>

      <!-- ---------------------------------------------------------------
           11 · Cold-section (full-width)
           --------------------------------------------------------------- -->
      <div class="glass mb-6 rounded-2xl p-8">
        <div class="text-[11px] uppercase tracking-[0.15em] text-[var(--dim)]">11 · Cold-section</div>
        <h3 class="display mt-3 text-2xl">A geological cross-section.</h3>
        <p class="mt-3 max-w-3xl text-sm text-[var(--ink-2)]">
          Five layers of a complete custody stack, surveyed top-down. Each
          band shows its <em>online surface</em> — the percentage of time and
          area exposed to network attackers. <strong>Tap a layer</strong> to
          peel it back and see how that layer fails.
        </p>

        <div class="cold-section mt-8">
          {[
            {
              name: "Custodial / exchange",
              tag: "0% you own it",
              temp: "hot",
              depth: "100%",
              depthLabel: "online",
              body: "Your funds are an IOU from a company. The company has the keys; you have an account. Risk: insolvency, account freeze, hack, regulatory action.",
              failure: "company failure",
            },
            {
              name: "Mobile / browser wallet",
              tag: "you own keys, device online",
              temp: "warm",
              depth: "85%",
              depthLabel: "online",
              body: "Keys are on a connected device. Convenient for small spend. Risk: malware, phishing in-app, device theft, OS exploits.",
              failure: "device compromise",
            },
            {
              name: "Desktop wallet",
              tag: "online keys, full node",
              temp: "cool",
              depth: "60%",
              depthLabel: "online",
              body: "Keys are on a desktop. Useful for power users running their own node. Risk profile similar to mobile but the attack surface is the host OS.",
              failure: "OS compromise",
            },
            {
              name: "Hardware wallet",
              tag: "keys airgapped from host",
              temp: "cold",
              depth: "5%",
              depthLabel: "tx signing",
              body: "Keys live on a dedicated chip. Signing happens with no network involvement. Risk: supply-chain tamper, on-device firmware bug, passphrase loss.",
              failure: "device unavailability",
            },
            {
              name: "Air-gapped steel backup",
              tag: "the wallet, written",
              temp: "airgap",
              depth: "0%",
              depthLabel: "offline",
              body: "Twenty-four words on stainless. No screen, no battery, no firmware. Cannot be hacked over a network because there is no network. Risk: physical loss, theft, forgetting where it is.",
              failure: "physical loss",
            },
          ].map((b) => (
            <details class="cold-section__band" data-temp={b.temp}>
              <summary>
                <div class="cold-section__depth">
                  <div class="cold-section__depth-val">{b.depth}</div>
                  <div class="cold-section__depth-label">{b.depthLabel}</div>
                </div>
                <div class="cold-section__name">
                  {b.name}
                  <div class="cold-section__tag">{b.tag}</div>
                </div>
                <span class="coerce-tier__chev mr-2" aria-hidden="true">›</span>
              </summary>
              <div class="cold-section__body" style="padding-left: 0;">
                {b.body}
                <div class="cold-section__failure">↳ fails as · {b.failure}</div>
              </div>
            </details>
          ))}
        </div>
      </div>

      <!-- ---------------------------------------------------------------
           13 · Geolocation pins + 14 · Shamir splitter (two-up)
           --------------------------------------------------------------- -->
      <div class="mb-6 grid grid-cols-1 gap-6 md:grid-cols-2">
        <!-- Geolocation pins -->
        <div class="glass rounded-2xl p-8">
          <div class="text-[11px] uppercase tracking-[0.15em] text-[var(--dim)]">13 · Geolocation</div>
          <h3 class="display mt-3 text-2xl">Three pins, one event.</h3>
          <p class="mt-3 text-sm text-[var(--ink-2)]">
            Three backups are not three backups if they share a single
            disaster radius. <strong>Drag the pins</strong>; sweep the radius
            from a house fire (1 km) to a regional blackout (500 km). Watch
            independent failure modes collapse.
          </p>

          <div class="geoloc mt-6" id="geoloc" data-components="3">
            <svg viewBox="0 0 400 260" class="geoloc__map" aria-hidden="true">
              <defs>
                <pattern id="geoloc-grid" width="40" height="40" patternUnits="userSpaceOnUse">
                  <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(31,58,104,0.08)" stroke-width="0.5"/>
                </pattern>
              </defs>
              <rect width="400" height="260" fill="url(#geoloc-grid)" />

              <!-- World map — Natural Earth 110m land outline, equirectangular -->
              <g class="geoloc__land" transform="translate(0, 30)">
                <path d={worldLandPath} />
              </g>

              <!-- Equator line -->
              <line x1="0" y1="130" x2="400" y2="130" class="geoloc__equator" />

              <!-- blast rings -->
              <g class="geoloc__rings">
                <circle class="geoloc__ring" data-pin="A" cx="90"  cy="80"  r="20" />
                <circle class="geoloc__ring" data-pin="B" cx="335" cy="85"  r="20" />
                <circle class="geoloc__ring" data-pin="C" cx="165" cy="160" r="20" />
              </g>

              <!-- pins -->
              <g class="geoloc__pin" data-pin="A" transform="translate(90, 80)">
                <circle r="14" class="geoloc__pin-bg" />
                <text y="4">A</text>
              </g>
              <g class="geoloc__pin" data-pin="B" transform="translate(335, 85)">
                <circle r="14" class="geoloc__pin-bg" />
                <text y="4">B</text>
              </g>
              <g class="geoloc__pin" data-pin="C" transform="translate(165, 160)">
                <circle r="14" class="geoloc__pin-bg" />
                <text y="4">C</text>
              </g>
            </svg>

            <div class="mt-6">
              <div class="flex justify-between text-[10px] uppercase tracking-[0.15em] text-[var(--dim)] font-mono mb-1">
                <span>blast radius</span>
                <strong class="mono-readout text-[var(--ink)] text-[12px]"><span id="geoloc-r">50</span> km</strong>
              </div>
              <input
                type="range"
                id="geoloc-slider"
                class="cold-slider"
                min="0"
                max="500"
                value="50"
                step="10"
                aria-label="Blast radius in kilometres"
              />
            </div>

            <div class="geoloc__status" id="geoloc-status" aria-live="polite">3 backups · 3 independent failure modes</div>
          </div>
        </div>

        <!-- Shamir splitter -->
        <div class="glass rounded-2xl p-8">
          <div class="text-[11px] uppercase tracking-[0.15em] text-[var(--dim)]">14 · Shamir / SSKR</div>
          <h3 class="display mt-3 text-2xl">3-of-5, none alone.</h3>
          <p class="mt-3 text-sm text-[var(--ink-2)]">
            Different from multisig: the <em>seed itself</em> is split. Each
            share is mathematical nonsense on its own. <strong>Tap shares</strong>
            until any three light up — the seed reassembles.
          </p>

          <div class="shamir mt-6" id="shamir" data-restored="false">
            <div class="shamir__center">
              <div class="shamir__seed">
                <div class="shamir__seed-label">recovered seed</div>
                <div class="shamir__seed-words mono-readout" id="shamir-words">— — — — — — — — — —</div>
                <div class="shamir__seed-status mono-readout" id="shamir-substatus">insufficient shares</div>
              </div>
            </div>
            <div class="shamir__shares">
              {[
                { i: 1, frag: "1eJaXz…m9N4" },
                { i: 2, frag: "vQ74yA…0LfP" },
                { i: 3, frag: "Bp31cZ…8hKy" },
                { i: 4, frag: "Nf2X7d…r5Tk" },
                { i: 5, frag: "9LtVZ7…pQ4j" },
              ].map((s) => (
                <button type="button" class="shamir__share" data-share={s.i} aria-pressed="false">
                  <div class="shamir__share-num">{s.i}</div>
                  <div class="shamir__share-frag mono-readout">{s.frag}</div>
                </button>
              ))}
            </div>
            <div class="shamir__status" id="shamir-status">0 of 5 · need 3 to reconstruct</div>
          </div>
        </div>
      </div>

      <!-- ---------------------------------------------------------------
           15 · BIP85 tree + 16 · Passphrase tree (two-up)
           --------------------------------------------------------------- -->
      <div class="mb-6 grid grid-cols-1 gap-6 md:grid-cols-2">
        <!-- BIP85 derivation tree -->
        <div class="glass rounded-2xl p-8">
          <div class="text-[11px] uppercase tracking-[0.15em] text-[var(--dim)]">15 · BIP-85</div>
          <h3 class="display mt-3 text-2xl">One seed, infinite children.</h3>
          <p class="mt-3 text-sm text-[var(--ink-2)]">
            BIP-85 derives <em>deterministic</em> child secrets from a single
            master seed — child wallets, passwords, hex blobs. Back up one;
            recover everything. <strong>Hover a leaf</strong> for its path.
          </p>

          <div class="bip85 mt-6" id="bip85">
            <svg viewBox="0 0 540 300" class="bip85__svg" aria-hidden="true">
              <!-- edges -->
              <g class="bip85__edges">
                <line class="bip85__edge" data-child="c1" x1="270" y1="50" x2="60"  y2="200" />
                <line class="bip85__edge" data-child="c2" x1="270" y1="50" x2="165" y2="200" />
                <line class="bip85__edge" data-child="c3" x1="270" y1="50" x2="270" y2="200" />
                <line class="bip85__edge" data-child="c4" x1="270" y1="50" x2="375" y2="200" />
                <line class="bip85__edge" data-child="c5" x1="270" y1="50" x2="480" y2="200" />
              </g>

              <!-- master -->
              <g class="bip85__node bip85__master" transform="translate(270, 50)">
                <path class="bip85__hex" d="M 0 -18 L 16 -9 L 16 9 L 0 18 L -16 9 L -16 -9 Z" />
                <path class="bip85__crystal" d="M 0 -10 L 9 -3 L 0 8 L -9 -3 Z" />
                <text y="-26" class="bip85__node-label">master</text>
              </g>

              <!-- children -->
              {[
                { id: "c1", x: 60,  label: "12w", type: "BIP-39 · 12 words", path: "m/83696968'/39'/0'/12'/0'" },
                { id: "c2", x: 165, label: "24w", type: "BIP-39 · 24 words", path: "m/83696968'/39'/0'/24'/0'" },
                { id: "c3", x: 270, label: "hex", type: "32 random bytes",   path: "m/83696968'/128169'/32'/0'" },
                { id: "c4", x: 375, label: "wif", type: "WIF private key",   path: "m/83696968'/2'/0'" },
                { id: "c5", x: 480, label: "pw",  type: "BIP-39 password",   path: "m/83696968'/707764'/20'/0'" },
              ].map((c) => (
                <>
                  <g class="bip85__node bip85__child" data-child={c.id} transform={`translate(${c.x}, 200)`}>
                    <path class="bip85__hex" d="M 0 -16 L 14 -8 L 14 8 L 0 16 L -14 8 L -14 -8 Z" />
                    <text y="3" class="bip85__node-label">{c.label}</text>
                  </g>
                  <g class="bip85__caption" data-child={c.id} transform={`translate(${c.x}, 240)`}>
                    <text y="0" class="bip85__type" text-anchor="middle">{c.type}</text>
                    <text y="14" class="bip85__path" text-anchor="middle">{c.path}</text>
                  </g>
                </>
              ))}
            </svg>

            <p class="bip85__caption-default text-xs text-[var(--dim)] text-center mt-3" id="bip85-caption">
              hover a child to highlight its derivation path
            </p>
          </div>
        </div>

        <!-- Passphrase tree (decoy wallet) -->
        <div class="glass rounded-2xl p-8">
          <div class="text-[11px] uppercase tracking-[0.15em] text-[var(--dim)]">16 · Passphrase tree</div>
          <h3 class="display mt-3 text-2xl">The 25th word.</h3>
          <p class="mt-3 text-sm text-[var(--ink-2)]">
            The same 24 words + a different passphrase = an entirely
            different wallet. A small decoy at "no passphrase" is the
            defense against the bottom rung of the coercion ladder.
          </p>

          <div class="ptree mt-6" id="ptree">
            <div class="ptree__seed">
              <div class="ptree__seed-label">24 words · BIP-39</div>
              <div class="ptree__seed-mock mono-readout">winter saddle harbor compact … abandon</div>
            </div>

            <svg viewBox="0 0 300 60" class="ptree__connector" aria-hidden="true">
              <path d="M 150 0 L 150 25 L 50 25 L 50 60" />
              <path d="M 150 0 L 150 25 L 150 60" />
              <path d="M 150 0 L 150 25 L 250 25 L 250 60" />
            </svg>

            <div class="ptree__branches">
              {[
                { id: "p1", pass: "(no passphrase)", addr: "bc1q…x4lz", bal: "0.05 BTC", kind: "decoy" },
                { id: "p2", pass: "\"vacation\"",    addr: "bc1q…t7vk", bal: "0.42 BTC", kind: "mid" },
                { id: "p3", pass: "(long phrase)",   addr: "bc1q…9q8m", bal: "187 BTC",  kind: "real" },
              ].map((b) => (
                <button type="button" class="ptree__branch" data-kind={b.kind} data-branch={b.id}>
                  <div class="ptree__pass mono-readout">{b.pass}</div>
                  <div class="ptree__wallet">
                    <div class="ptree__addr mono-readout">{b.addr}</div>
                    <div class="ptree__bal">{b.bal}</div>
                  </div>
                </button>
              ))}
            </div>

            <p class="text-xs text-[var(--dim)] mt-4">
              <strong>Three wallets, one seed.</strong> Under coercion, you
              reveal the seed; without the 25th word, the attacker walks away
              with the decoy.
            </p>
          </div>
        </div>
      </div>

      <!-- ---------------------------------------------------------------
           17 · Recovery rehearsal stopwatch (full-width)
           --------------------------------------------------------------- -->
      <div class="glass mb-6 rounded-2xl p-8">
