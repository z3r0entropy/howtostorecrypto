            twentieth, days; by the thirtieth, a lifetime.
          </p>

          <div class="backoff mt-6" id="backoff">
            <div class="backoff__chart">
              {(() => {
                const sample = [1, 4, 7, 10, 13, 16, 19, 22, 25, 28];
                const maxLog = Math.log(2 ** 28);
                return sample.map((n) => {
                  const sec = Math.pow(2, n);
                  const width = (Math.log(sec) / maxLog) * 100;
                  const fmt = (s: number) =>
                    s < 60 ? `${s} s`
                    : s < 3600 ? `${Math.round(s / 60)} m`
                    : s < 86400 ? `${(s / 3600).toFixed(1)} h`
                    : s < 31536000 ? `${Math.round(s / 86400)} d`
                    : `${(s / 31536000).toFixed(1)} y`;
                  return (
                    <div class="backoff__row" data-attempt={n}>
                      <div class="backoff__attempt mono-readout">#{n}</div>
                      <div class="backoff__bar">
                        <div class="backoff__bar-fill" style={`width: ${width.toFixed(1)}%`}></div>
                      </div>
                      <div class="backoff__time mono-readout">{fmt(sec)}</div>
                    </div>
                  );
                });
              })()}
            </div>

            <div class="mt-6">
              <div class="flex justify-between text-[10px] uppercase tracking-[0.15em] text-[var(--dim)] font-mono mb-1">
