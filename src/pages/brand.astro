    // ============================================================
    //  Recovery rehearsal — animate needle through 5 phases
    // ============================================================
    {
      const root = document.getElementById("rehearsal");
      const playBtn = document.getElementById("rehearsal-play");
      const resetBtn = document.getElementById("rehearsal-reset");
      const needle = document.getElementById("rehearsal-needle");
      const timeOut = document.getElementById("rehearsal-time");
      if (root && playBtn && resetBtn && needle && timeOut) {
        const phaseMin = [1, 1, 5, 1, 2]; // 10 min total
        const totalMin = phaseMin.reduce((a, b) => a + b, 0);
        const fractions = phaseMin.map((m) => m / totalMin);
        // Cumulative fractions
        const cum: number[] = [];
        let acc = 0;
        for (const f of fractions) { acc += f; cum.push(acc); }

        const phaseIds = ["p1", "p2", "p3", "p4", "p5"];
        const phases = root.querySelectorAll<HTMLElement>(".rehearsal__phase");
        const sectors = root.querySelectorAll<SVGPathElement>(".rehearsal__sector");

        const DURATION_MS = 9500;
        let raf: number | null = null;
        let startedAt = 0;

        const setActivePhase = (pid: string | null) => {
          phases.forEach((p) => p.classList.toggle("is-current", p.dataset.phase === pid));
          sectors.forEach((s) => s.classList.toggle("is-current", s.dataset.phase === pid));
        };

        const fmtTime = (remainingMin: number) => {
          const totalSec = Math.max(0, Math.round(remainingMin * 60));
          const mm = Math.floor(totalSec / 60);
          const ss = totalSec % 60;
          return `${mm}:${String(ss).padStart(2, "0")}`;
        };

        const reset = () => {
          if (raf !== null) { cancelAnimationFrame(raf); raf = null; }
          root.classList.remove("is-playing");
          needle.setAttribute("transform", "rotate(0)");
          timeOut.textContent = "10:00";
          setActivePhase(null);
          if (playBtn) (playBtn as HTMLButtonElement).textContent = "▷ Start rehearsal";
        };

        const tick = (now: number) => {
          const t = Math.min(1, (now - startedAt) / DURATION_MS);
          needle.setAttribute("transform", `rotate(${t * 360})`);
          const remaining = totalMin * (1 - t);
          timeOut.textContent = fmtTime(remaining);
          let currentPhase: string | null = null;
          for (let i = 0; i < cum.length; i++) {
            if (t <= cum[i]) { currentPhase = phaseIds[i]; break; }
          }
          if (t >= 1) currentPhase = phaseIds[phaseIds.length - 1];
          setActivePhase(currentPhase);
          if (t < 1) {
            raf = requestAnimationFrame(tick);
          } else {
            raf = null;
            root.classList.remove("is-playing");
            if (playBtn) (playBtn as HTMLButtonElement).textContent = "▷ Start rehearsal";
          }
        };

        const play = () => {
          if (raf !== null) return;
          root.classList.add("is-playing");
          startedAt = performance.now();
          if (playBtn) (playBtn as HTMLButtonElement).textContent = "▷ Running…";
          raf = requestAnimationFrame(tick);
        };

        playBtn.addEventListener("click", play);
        resetBtn.addEventListener("click", reset);
        reset();
      }
    }

