          <div class="privlayer mt-6" id="privlayer">
            {[
              { id: "isp",   name: "ISP",          can: "sees you connected to wallet servers · timing leaks",        on: true },
              { id: "vpn",   name: "VPN",          can: "ISP sees nothing · VPN sees everything",                      on: false },
              { id: "tor",   name: "Tor",          can: "circuit hops · no single node knows both ends",                on: false },
