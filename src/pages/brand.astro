        const locTiles = root.querySelectorAll<HTMLElement>(".spof__loc");
        const update = () => {
          const counts: Record<string, number> = Object.fromEntries(LOCATIONS.map((l) => [l, 0]));
          backups.forEach((b) => { counts[b.dataset.loc ?? ""]++; });
          locTiles.forEach((t) => {
            const id = t.dataset.locId ?? "";
