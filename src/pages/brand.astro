  <script>
    // ============================================================
    //  Multisig constellation — auto-cycling signing-quorum + interactive lose-key
    // ============================================================
    {
      const root = document.getElementById("multisig");
      const status = document.getElementById("multisig-status");
      const detail = document.getElementById("multisig-detail");
      const resetBtn = document.getElementById("multisig-reset");

      if (root && status && detail && resetBtn) {
        const total = 3;
        const threshold = 2;
        const allKeys = ["1", "2", "3"];
        let lost = new Set<string>();
        let signing = new Set<string>();
        let autoMode = true;
        let autoTimer: number | null = null;

        const keys = root.querySelectorAll<HTMLButtonElement>(".multisig-key");
        const outerEdges = root.querySelectorAll<SVGElement>(".multisig-edge[data-endpoints]");
        const vaultEdges = root.querySelectorAll<SVGElement>(".multisig-edge-vault[data-key]");

        const shuffle = <T,>(arr: T[]): T[] => [...arr].sort(() => Math.random() - 0.5);

        const render = () => {
          const present = total - lost.size;
          const quorum = present >= threshold;

          keys.forEach((k) => {
            const id = k.dataset.key ?? "";
            k.classList.toggle("multisig-key--lost", lost.has(id));
            k.classList.toggle("multisig-key--signing", signing.has(id) && !lost.has(id));
          });
          outerEdges.forEach((e) => {
            const eps = (e.getAttribute("data-endpoints") ?? "").split("-");
            const anyLost = eps.some((x) => lost.has(x));
            const bothSigning = eps.every((x) => signing.has(x));
            e.classList.toggle("multisig-edge--lost", anyLost);
            e.classList.toggle("multisig-edge--signing", bothSigning && !anyLost);
          });
          vaultEdges.forEach((e) => {
            const id = e.getAttribute("data-key") ?? "";
            e.classList.toggle("multisig-edge--lost", lost.has(id));
            e.classList.toggle("multisig-edge--signing", signing.has(id) && !lost.has(id));
          });

          root.dataset.lost = String(lost.size);
          root.dataset.quorum = quorum ? "true" : "false";

          if (quorum) {
            status.textContent = `${present} of ${total} · funds safe`;
            status.className = "display text-lg text-[var(--ok)]";
            if (autoMode && present === total) {
              detail.textContent = "Quorum met — any two of three sign. Highlighted pair is the rehearsal.";
            } else if (present === total) {
              detail.textContent = "All keys present. Threshold is 2.";
            } else {
              detail.textContent = `${total - present} key lost. Still above threshold — spend with any two.`;
            }
          } else {
            status.textContent = `${present} of ${total} · funds lost`;
            status.className = "display text-lg text-[var(--warn)]";
            detail.textContent = "Below threshold. Multisig has done its job — and now exposed yours.";
          }
        };

        const autoTick = () => {
          const r = Math.random();
          const numLost = r < 0.55 ? 0 : r < 0.88 ? 1 : 2;
          const pool = [...allKeys];
          const lostNew = new Set<string>();
          for (let i = 0; i < numLost; i++) {
            const idx = Math.floor(Math.random() * pool.length);
            lostNew.add(pool.splice(idx, 1)[0]);
          }
          lost = lostNew;
          const remaining = allKeys.filter((k) => !lost.has(k));
          signing = remaining.length >= threshold
            ? new Set(shuffle(remaining).slice(0, threshold))
            : new Set();
          render();
        };

        const startAuto = () => {
          autoMode = true;
          if (autoTimer !== null) window.clearInterval(autoTimer);
          autoTick();
          autoTimer = window.setInterval(autoTick, 3500);
        };

        const stopAuto = () => {
          autoMode = false;
          if (autoTimer !== null) {
            window.clearInterval(autoTimer);
            autoTimer = null;
          }
        };

        keys.forEach((key) => {
          key.addEventListener("click", () => {
            stopAuto();
            const id = key.dataset.key ?? "";
            if (lost.has(id)) lost.delete(id);
            else lost.add(id);
            signing = new Set();
            render();
          });
        });

        resetBtn.addEventListener("click", () => {
          lost = new Set();
          signing = new Set();
          startAuto();
        });

        startAuto();
      }
    }

