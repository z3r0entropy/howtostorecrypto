            if (c) c.textContent = String(n);
          });
          const overFull = Object.entries(counts).filter(([_, n]) => n >= 2);
          const max = Math.max(...Object.values(counts));
          if (overFull.length === 0) {
            root.dataset.spof = "none";
            statusEl.textContent = "3 backups at 3 unique locations · resilient";
          } else if (max === 3) {
            const [loc] = overFull.find(([_, n]) => n === 3) ?? ["?", 0];
            root.dataset.spof = "catastrophic";
            statusEl.textContent = `all 3 backups at ${loc} · catastrophic single point of failure`;
