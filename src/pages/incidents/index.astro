---
import { getCollection } from "astro:content";
import Layout from "~/layouts/Layout.astro";
import { url } from "~/lib/url";
import { STATUS_META } from "~/lib/incidents-taxonomy";

// Stub hub — Phase 2 builds the full filterable/sortable timeline.
// For now we ship a chronological list with the key facts, so the
// individual incident pages have a parent in the IA.

const entries = await getCollection("incidents", ({ data }) => !data.draft);

// Sort newest-first by occurredOn (year-only is fine).
entries.sort((a, b) => (b.data.occurredOn ?? "").localeCompare(a.data.occurredOn ?? ""));

const totalLossUsd = entries.reduce((sum, e) => sum + (e.data.amountUsd ?? 0), 0);
const totalRecoveredUsd = entries.reduce((sum, e) => sum + (e.data.recoveredUsd ?? 0), 0);

function formatAmount(amount: number): string {
  if (amount === 0) return "—";
  if (amount >= 1_000_000_000) return `$${(amount / 1_000_000_000).toFixed(2)}B`;
  if (amount >= 1_000_000) return `$${(amount / 1_000_000).toFixed(0)}M`;
  if (amount >= 1_000) return `$${(amount / 1_000).toFixed(0)}K`;
  return `$${amount}`;
}

function formatYear(input?: string): string {
  if (!input) return "—";
  return input.slice(0, 4);
}

const statusToneClass: Record<"ok" | "warn" | "neutral" | "accent", string> = {
  ok: "bg-[rgba(47,148,104,0.14)] text-[var(--ok)]",
  warn: "bg-[rgba(196,92,58,0.14)] text-[var(--warn)]",
  neutral: "bg-[rgba(12,26,46,0.08)] text-[var(--ink-2)]",
  accent: "bg-[rgba(47,111,224,0.14)] text-[var(--accent-deep)]",
};

const siteUrl = "https://howtostorecrypto.com";

const itemListJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Crypto loss incidents — How to Store Crypto",
  itemListElement: entries.map((e, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: `${siteUrl}/incidents/${e.id}`,
    name: e.data.title,
  })),
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${siteUrl}/` },
    { "@type": "ListItem", position: 2, name: "Incidents", item: `${siteUrl}/incidents` },
  ],
};
---

<Layout
  title="Crypto loss & theft incidents — sourced, dated, with prevention"
  description="An ongoing database of crypto loss and theft incidents. Each entry is dated, sourced, and paired with the specific storage methods that would have prevented it."
  keywords="crypto hacks list, crypto theft database, biggest crypto losses, exchange hacks, bitcoin theft incidents, crypto scams history"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </Fragment>

  <main class="mx-auto max-w-5xl px-6 pt-32 md:px-10">
    {/* Breadcrumb */}
    <nav class="mb-8 flex items-center gap-2 text-xs text-[var(--dim)]" aria-label="Breadcrumb">
      <a href={url("/")} class="hover:text-[var(--ice-deep)]">Home</a>
      <span>·</span>
      <span class="text-[var(--ink-2)]">Incidents</span>
    </nav>

    {/* Header */}
    <header class="pb-16">
      <div class="pill">
        <span class="pill-dot"></span>
        {entries.length} {entries.length === 1 ? "entry" : "entries"} · updated regularly
      </div>
      <h1 class="display mt-6 text-[clamp(2.5rem,6vw,5rem)] leading-[1]">
        Crypto loss incidents,
        <br />
        <span class="stat-grad italic">sourced and dated.</span>
      </h1>
      <p class="mt-8 max-w-2xl text-lg leading-relaxed text-[var(--ink-2)] md:text-xl">
        An ongoing, structured record of how people and platforms have lost
        crypto. Each entry includes a documented source, a verifiable
        status, and the specific storage methods that would have prevented
        it.
      </p>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-[var(--dim)]">
        The point isn't morbid record-keeping — it's that every form of
        permanent loss this site documents already has a fix.
        See <a href={url("/incidents/methodology")} class="text-[var(--accent)] hover:text-[var(--accent-deep)]">how we source and verify incidents</a>.
      </p>

      {/* Aggregate stats */}
      <dl class="mt-12 grid grid-cols-2 gap-4 md:grid-cols-3">
        <div class="glass rounded-2xl p-5">
          <dt class="text-[10px] uppercase tracking-[0.15em] text-[var(--dim)]">Documented incidents</dt>
          <dd class="display stat-grad mt-1 text-3xl">{entries.length}</dd>
        </div>
        <div class="glass rounded-2xl p-5">
          <dt class="text-[10px] uppercase tracking-[0.15em] text-[var(--dim)]">Estimated total lost</dt>
          <dd class="display stat-grad mt-1 text-3xl">{formatAmount(totalLossUsd)}</dd>
          <div class="mt-1 text-[10px] text-[var(--dim)]">at time of each incident</div>
        </div>
        <div class="glass rounded-2xl p-5">
          <dt class="text-[10px] uppercase tracking-[0.15em] text-[var(--dim)]">Estimated recovered</dt>
          <dd class="display mt-1 text-3xl">{formatAmount(totalRecoveredUsd)}</dd>
        </div>
      </dl>
    </header>

    {/* Phase-1 note */}
    <aside class="glass mb-12 rounded-2xl border hairline-strong p-5">
      <div class="text-[10px] uppercase tracking-[0.15em] text-[var(--dim)]">Phase 1</div>
      <p class="mt-2 text-sm leading-relaxed text-[var(--ink-2)]">
        This index ships with five anchor incidents to validate the data
        model. Filterable timeline, category pages, and a leaderboard
        arrive in the next phase. New incidents are added on a rolling
        basis.
      </p>
    </aside>

    {/* List */}
    <section class="space-y-4">
      {entries.map((entry) => {
        const d = entry.data;
        const statusMeta = STATUS_META[d.status];
        return (
          <a href={url(`/incidents/${entry.id}`)} class="glass group block rounded-2xl p-6 transition hover:bg-white/75">
            <div class="grid grid-cols-12 items-baseline gap-4">
              <div class="col-span-12 md:col-span-2">
                <div class="display text-2xl md:text-3xl">{formatYear(d.occurredOn)}</div>
              </div>
              <div class="col-span-12 md:col-span-7">
                <div class="flex flex-wrap items-baseline gap-2">
                  <span class:list={["tag", statusToneClass[statusMeta.tone]]}>
                    {statusMeta.label}
                  </span>
                  <span class="tag tag-neutral">{d.attackVector.replace(/-/g, " ")}</span>
                </div>
                <h2 class="display mt-3 text-xl md:text-2xl">{d.title}</h2>
                <p class="mt-2 text-sm leading-relaxed text-[var(--ink-2)] md:text-base">
                  {d.summary}
                </p>
              </div>
              <div class="col-span-12 md:col-span-3 md:text-right">
                {d.amountUsd ? (
                  <>
                    <div class="text-[10px] uppercase tracking-[0.15em] text-[var(--dim)]">Estimated loss</div>
                    <div class="display stat-grad mt-1 text-2xl">{formatAmount(d.amountUsd)}</div>
                  </>
                ) : (
                  <div class="text-[10px] uppercase tracking-[0.15em] text-[var(--dim)]">Enabled subsequent losses</div>
                )}
              </div>
            </div>
          </a>
        );
      })}
    </section>

    {/* CTA back to learning */}
    <section class="mt-20">
      <div class="glass rounded-3xl p-8 md:p-10">
        <div class="pill"><span>Apply this</span></div>
        <h2 class="display mt-4 text-2xl md:text-3xl">
          Don't be the next entry.
        </h2>
        <p class="mt-3 max-w-2xl text-sm text-[var(--ink-2)] md:text-base">
          Every incident on this page is preventable, cheaply, with the
          methods on the rest of the site. The setup wizard turns the advice
          into a concrete plan.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={url("/app/setup")} class="btn btn-primary">Plan your setup →</a>
          <a href={url("/")} class="btn btn-secondary">Read the methods first</a>
        </div>
      </div>
    </section>
  </main>
</Layout>
