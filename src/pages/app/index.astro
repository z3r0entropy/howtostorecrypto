---
import Layout from "~/layouts/Layout.astro";

const tools = [
  {
    title: "Plan your setup",
    sub: "A guided wizard. Tier, stakes, recommended strategy, locations, inheritance, reminders. About 5 minutes.",
    href: "/app/setup",
    cta: "Open the wizard",
    eyebrow: "Wizard",
    accent: true,
  },
  {
    title: "Audit your current setup",
    sub: "Tell us what you have. We tell you what can go wrong — ranked by severity, with one fix per finding.",
    href: "/app/quiz/audit",
    cta: "Run the audit",
    eyebrow: "Diagnostic",
  },
  {
    title: "Test your knowledge",
    sub: "Ten questions on the actual mechanics. Your score becomes the recommended starting point for the wizard.",
    href: "/app/quiz/knowledge",
    cta: "Take the quiz",
    eyebrow: "Self-assessment",
  },
  {
    title: "Browse backup locations",
    sub: "A reference database of every place a backup can live, with category, resistance ratings, costs, and notes.",
    href: "/app/locations",
    cta: "Open the database",
    eyebrow: "Reference",
  },
];
---

<Layout
  title="Tools — How to Store Crypto"
  description="The interactive tools: setup wizard, current-setup audit, knowledge quiz, and a database of backup locations."
>
  <main class="mx-auto max-w-6xl px-6 pt-32 md:px-10">
    <!-- Header -->
    <header class="mb-16">
      <div class="pill">
        <span class="pill-dot"></span>
        Tools · the interactive part
      </div>
      <h1 class="display mt-6 text-[clamp(2.5rem,6vw,5.5rem)] leading-[0.95]">
        Pick what you need.
        <br />
        <span class="stat-grad italic">Skip the rest.</span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-[var(--ink-2)]">
        The reading on the front page is optional. These tools cover the part
        that actually matters — designing a custody setup that fits your level,
        your stakes, and your life.
      </p>
    </header>

    <!-- Tools grid -->
    <section class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {
        tools.map((t) => (
          <a
            href={t.href}
            class:list={[
              "glass group relative block rounded-3xl p-8 transition hover:bg-white/75",
              t.accent && "ring-2 ring-[var(--accent)]/30 shadow-2xl shadow-[var(--accent)]/10",
            ]}
          >
            <div class="flex items-baseline justify-between text-xs uppercase tracking-[0.2em] text-[var(--ice-deep)]">
              <span>{t.eyebrow}</span>
              <span class="text-[var(--dim)]">→</span>
            </div>
            <h2 class="display mt-6 text-3xl">{t.title}</h2>
            <p class="mt-3 text-base leading-relaxed text-[var(--ink-2)]">{t.sub}</p>
            <div class="mt-10 inline-flex items-center gap-2 text-sm text-[var(--accent)] transition group-hover:text-[var(--accent-deep)]">
              {t.cta}
              <span class="transition group-hover:translate-x-1">→</span>
            </div>
          </a>
        ))
      }
    </section>

    <!-- How to pick -->
    <section class="mt-20">
      <div class="glass rounded-3xl p-8 md:p-12">
        <div class="text-xs uppercase tracking-[0.2em] text-[var(--ice-deep)]">
          Not sure where to start?
        </div>
        <h2 class="display mt-4 text-3xl leading-tight md:text-4xl">
          One question:
          <span class="stat-grad italic">do you already have a setup?</span>
        </h2>

        <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-2">
          <a href="/app/quiz/audit" class="glass-dark rounded-2xl p-6 transition hover:bg-white/40">
            <div class="text-xs uppercase tracking-[0.15em] text-[var(--dim)]">Yes</div>
            <div class="display mt-2 text-xl">Audit what you have</div>
            <p class="mt-2 text-sm text-[var(--ink-2)]">
              Eight questions about your current setup. Output is a ranked
              list of risks with one fix each.
            </p>
            <div class="mt-4 text-sm text-[var(--accent)]">Open the audit →</div>
          </a>

          <a href="/app/setup" class="glass-dark rounded-2xl p-6 transition hover:bg-white/40">
            <div class="text-xs uppercase tracking-[0.15em] text-[var(--dim)]">No</div>
            <div class="display mt-2 text-xl">Plan a setup from scratch</div>
            <p class="mt-2 text-sm text-[var(--ink-2)]">
              Wizard walks you through tier, stakes, and produces a
              specific recommendation with shopping list and steps.
            </p>
            <div class="mt-4 text-sm text-[var(--accent)]">Open the wizard →</div>
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
